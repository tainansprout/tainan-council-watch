833,838,845,851,857,864,871,876,884,891,897,901,906,912,918,924,930,935,941,945,951,955,960,966,970,975,980,986,993,999,1006,1013,1020,1028,1035,1041,1047,1052,1058,1064,1069,1074,1080,1086,1092,1100,1105,1111,1116,1122,1127],{"relatedOrgs":537,"summary":539,"editorNote":285,"say":285,"date":540,"type":541,"round":542,"src":543,"councilorRound":95},[538],"教育局","要求局長為九份子國民中小學開學在各方面做好準備，應付龐大的學生人數。","2022-10-12","定期會",6,[544],2113,{"relatedOrgs":546,"summary":547,"editorNote":285,"say":285,"date":540,"type":541,"round":542,"src":548,"councilorRound":95},[538],"肯定局長對安南全民運動館的建設的重視，希望局長在規劃過程嚴謹把關。",[549],2114,{"relatedOrgs":551,"summary":553,"editorNote":285,"say":554,"date":555,"type":541,"round":542,"src":556,"councilorRound":95},[552],"法制處","批評龍崎掩埋場、城西焚化爐更新案，以及沿海種電是市府三個錯誤的政策，並質疑沿海種電沒有給地方回饋金","錯誤的政策比貪污還嚴重，第一項，龍崎掩埋場是一個 錯誤的政策。第二項，城西焚化爐更新案，也是一個錯誤的政策。七股、將軍、學甲、 北門綠電，也是一個錯誤的政策。掩埋場絕對有存在的必要，本席也不反對，因為我們 現在看到臺南市所有的工、商業廢棄物四處傾倒，環保公司的價格，一天比一天高，市 長，你的錯誤政策，導致了這些問題，演變成這樣的情形","2021-11-22",[557],855,{"relatedOrgs":559,"summary":561,"editorNote":285,"say":562,"date":563,"type":541,"round":542,"src":564,"councilorRound":95},[560],"地政局","針對都市計畫與重劃區規劃","你們說會努力，但現在已經經過一年了，卻仍然是這樣，所以地政局很多業務，你 們自己要做很大的檢討，為什麼呢?因為地方的發展不能等。臺南市所有的公辦重劃及自 辦重劃，公辦重劃只佔 2 成 28 件，自辦重劃佔了 8 成 130 件，臺南市政府省下了用地徵 收費用及工程費用 400 億元，提供建築用地 444 公頃，提供公共設施用地 312 公頃，公 辦重劃都是政策性的，集中在同一區域，自辦重劃比較彈性，遍布都市到偏鄉，所以能 平均發展。","2021-11-05",[565],545,{"relatedOrgs":567,"summary":568,"editorNote":285,"say":569,"date":563,"type":541,"round":542,"src":570,"councilorRound":95},[538],"希望教育局針對九份子重劃區，學校、道路及停車場","教育局長，本席經過十年的爭取，在九份子重劃區中，現在這間學校可以 順利開學，這也是要感謝賴清德副總統，也要感謝黃偉哲市長，在他的任內，追加一筆 1,200 萬元的經費，才能讓這間學校順利開學，我也感謝市長，能體會地方學童的安全， 所以今年度編列了一筆 2,200 萬元的經費，要來開闢九份子重劃區的一條道路，讓這些 小朋友的出入，能有條安全的路回家。",[571],548,{"relatedOrgs":573,"summary":575,"editorNote":285,"say":576,"date":563,"type":541,"round":542,"src":577,"councilorRound":95},[574],"環保局","向環保局提出垃圾掩埋場與焚化爐","局長，現在臺南市的垃圾，為何會亂傾倒?臺南市的垃圾處理，為什麼會從 1 噸，幾 千元到現在要幾萬元?你們聽不聽的到，我不知道，本席就我聽到的跟您說，你們現在聽 到的，都是好的部分，不好的部分您聽不到，實話您也聽不到，工商業及環保團體，大 家耿耿於懷，等會民調您就能看到，這些所反應出來的事實，當時您就職時，退輔會及 歐欣在龍崎那裏，有一個 40 幾公頃的掩埋場，那 40 幾公頃的掩埋場，就是要解決臺南 市的這些垃圾問題，結果你們是怎麼想的、是怎麼思考的，我並不知道。但是你們將那 個掩埋場停掉了之後，造成了今日臺南市的這些垃圾問題，這是很現實的問題，因為一 個蘿蔔一個坑，這個掩埋場是有經過環評的，有經過臺南市政府同意的，結果你們卻將 其停掉了，而且還要國家賠償，這對於您、對於整個財政、對於這些垃圾而言，事實上 是最下策，你們當時會做那樣的決議，絕對沒有考量到今日的這些垃圾問題。",[578],551,{"relatedOrgs":580,"summary":581,"editorNote":285,"say":582,"date":563,"type":541,"round":542,"src":583,"councilorRound":95},[],"向市長提出太陽能、海水淡化、垃圾問題、焚化爐的問題","您有 5 項問題，第一項太陽能光電，全部的七股人都知道，有一位姓陳的人，在處 理這些事情，這位姓陳的人已經不在了，當時我代替您去開會，我是怎麼跟您說的?國 家的政策，缺電要做太陽能沒有關係，廠商投資 100 億元，會有 5 億元的回饋，我跟您 說，希望臺南市政府能挺電商，將這 5 億元的回饋，給附近所有的民眾，讓大家都有。",[584],553,{"relatedOrgs":586,"summary":588,"editorNote":285,"say":589,"date":590,"type":541,"round":542,"src":591,"councilorRound":95},[587],"文化局","反映對於天馬電臺開發案，地方民眾希望那可以發展成都會公園，結合電臺的歷史和地方的農漁產品及文化，打造成休閒空間。","文化局葉局長，關於安南區天馬電臺促參案的對外招商，他們要做旅館、藝術、觀光產業，這件事情現在情形怎麼樣","2021-10-08",[592],2019,{"relatedOrgs":594,"summary":596,"editorNote":285,"say":597,"date":598,"type":541,"round":542,"src":599,"councilorRound":95},[595],"民政局","質詢安南區公所重建問題","民政局局長，安南區公所已經是危樓了，安南區公所已經是危樓了，地方很明顯的態度就是公所要找地方重蓋，","2021-10-06",[600],1818,{"relatedOrgs":602,"summary":603,"editorNote":285,"say":604,"date":605,"type":541,"round":542,"src":606,"councilorRound":95},[560],"質詢重劃區法令限制問題","感謝主席。地政局局長，陳局長。我們台南市的房價高居不下，","2021-10-01",[607],1524,{"relatedOrgs":609,"summary":610,"editorNote":285,"say":611,"date":605,"type":541,"round":542,"src":612,"councilorRound":95},[560],"質詢公辦都更面積法令問題","來，地政局局長。本席不能接受，3公頃以上要公辦，",[613],1527,{"relatedOrgs":615,"summary":617,"editorNote":285,"say":618,"date":619,"type":541,"round":542,"src":620,"councilorRound":95},[616],"水利局","瞭解安中抽水站能否在112能如期完工","感謝主席。水利局局長，商60抽水站是否能如期在111年3月完工？","2021-09-30",[621],1397,{"relatedOrgs":623,"summary":625,"editorNote":285,"say":626,"date":627,"type":541,"round":542,"src":628,"councilorRound":95},[624],"警察局","質詢改善閒置派出所活化問題及大型車違規取締問題","謝謝主席。方局長跟你建議，海佃路有一間派出所，","2021-09-28",[629],1203,{"relatedOrgs":631,"summary":633,"editorNote":285,"say":634,"