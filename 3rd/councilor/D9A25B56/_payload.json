7,793,798,804],{"relatedOrgs":537,"summary":538,"editorNote":285,"say":539,"date":540,"type":541,"round":542,"src":543,"councilorRound":95},[],"肯定防疫表現","臺南市已經有120 日零確診，各局處都非常認真，市長，你要不要說一下？你們在防疫工作上表現得那麼好","2021-10-26","定期會",6,[544],277,{"relatedOrgs":546,"summary":548,"editorNote":285,"say":549,"date":540,"type":541,"round":542,"src":550,"councilorRound":95},[547],"民政局","建議擴編衛生局人力","有一點要請市長、民政局長及衛生局長注意一下，現在疫苗都在衛生所施打，尤其地方上衛生所都很飽和，我覺得衛生局的人力較不足，今天拜託市長或民政局長在施打疫苗時，公所能否派人協助？那些長輩需要掛號或有其他問題要詢問至少有人可以幫忙，讓民眾感到市長和各局處對於防疫工作非常認真且貼近民意，民政局長你的看法如何？\n\n",[544],{"relatedOrgs":552,"summary":554,"editorNote":285,"say":555,"date":540,"type":541,"round":542,"src":556,"councilorRound":95},[553],"經濟發展局","詢問學甲市場進度","首先要感謝市長和經發局，學甲市場從106 年開始訴訟至今終於開工了，在此代表地方感謝市長和經發局。局長，你看什麼時候可以完成？大概說明一下",[557],278,{"relatedOrgs":559,"summary":560,"editorNote":285,"say":561,"date":540,"type":541,"round":542,"src":562,"councilorRound":95},[],"肯定南53線品質","這條南53 線也已經十多年了，84 線通車，這條路也算是主要道路。早期這條路要會車是很困難的，你看照片中道路拓寬完成後，聯外交通改善很多，市長你有去看吧？這條路做得很不錯",[563],279,{"relatedOrgs":565,"summary":567,"editorNote":285,"say":568,"date":540,"type":541,"round":542,"src":569,"councilorRound":95},[566],"教育局","詢問華宗盃辦理","年是學甲華宗盃第四十一屆，今年非常惋惜在疫情期間沒辦法舉辦，參賽隊伍其實很多，地方上也關心為什麼今年沒有舉辦華宗盃？教育局長",[563],{"relatedOrgs":571,"summary":572,"editorNote":285,"say":573,"date":540,"type":541,"round":542,"src":574,"councilorRound":95},[566],"要求華宗盃以學甲為主","天仁工商這邊有閒置土地，能否拜託市長或是局長幫忙爭取經費？讓華宗盃以學甲為主，不然現在比賽有的都要到麻豆，局長，你的看法呢",[575],280,{"relatedOrgs":577,"summary":579,"editorNote":285,"say":580,"date":540,"type":541,"round":542,"src":581,"councilorRound":95},[578],"水利局局長","詢問抽水站進度","法源抽水站及M 幹線抽水站也是我們地方重大建設，關係著淹水問題，學甲法源抽水站經費4 億6,000 多萬，局長，這案子的進度是否要趕一下？工期600 天，現在應該要開工了",[582],281,{"relatedOrgs":584,"summary":585,"editorNote":285,"say":586,"date":540,"type":541,"round":542,"src":587,"councilorRound":95},[578],"詢問下溪洲抽水站進度","外下溪洲抽水站新建工程何時可以完工？你要不要順便跟大家說一下",[582],{"relatedOrgs":589,"summary":591,"editorNote":285,"say":592,"date":540,"type":541,"round":542,"src":593,"councilorRound":95},[590],"水利局","要求改善馬沙溝排水","0809 馬沙溝因為急促豪雨致災，雖然這裡治水做得也非常好，但可能因為剛好這50 戶地勢較低水排不出去，我那天也有拜託水利局科長，他也很用心馬上就過來了，市長，你看這個",[582],{"relatedOrgs":595,"summary":596,"editorNote":285,"say":597,"date":540,"type":541,"round":542,"src":598,"councilorRound":95},[590],"詢問北門三寮灣、蘆竹溝、文山里排水方案","8 月9 日豪雨也造成北門三寮灣、蘆竹溝及文山里都淹水，請局長及有關單位針對這三里為什麼會排水不及予以檢討並研議長治久安的方案，局長，你認為如何",[599],282,{"relatedOrgs":601,"summary":603,"editorNote":285,"say":604,"date":540,"type":541,"round":542,"src":605,"councilorRound":95},[602],"工務局","要求改善南32排水","照片中是七股區南32，這條路有會勘過，應該是工務局的業務，這可能是道路斜度不夠所以逢雨必淹，這件案子應該會勘過",[606],283,{"relatedOrgs":608,"summary":609,"editorNote":285,"say":610,"date":540,"type":541,"round":542,"src":611,"councilorRound":95},[590],"麻豆營後排水改善","在麻豆營後這邊，現在這條水路從瓦寮及豐和里來，局長，本席曾在議會質詢，你看要如何處理",[606],{"relatedOrgs":613,"summary":616,"editorNote":285,"say":617,"date":618,"type":541,"round":619,"src":620,"councilorRound":95},[614,615],"文化局","觀旅局","指出華宗盃參賽隊伍增加，但學甲當地的球場不足，要求協助此問題。爭取在廢校的天仁工商規劃球場，荒廢的教室也可作為選手村使用。並建議在活動期間安排地方觀光活動。","市長，華宗盃你也非常用心，記者會\n跟開幕典禮你都出席，","2020-11-19",4,[621],816,{"relatedOrgs":623,"summary":624,"editorNote":285,"say":625,"date":618,"type":541,"round":619,"src":626,"councilorRound":95},[602],"詢問學甲外環道路6號道路的規劃進度。","現在學甲外環道路6 號道路剩這一條還沒開通，我們鄉鎮就一直爭取、一直爭取",[627],818,{"relatedOrgs":629,"summary":631,"editorNote":285,"say":632,"date":618,"type":541,"round":619,"src":633,"councilorRound":95},[630],"經發局","要求加速處理學甲市場的規劃。","經發局長我告訴你，這市場已經幾十年了，從我擔任鎮長的時候就要拆，",[627],{"relatedOrgs":635,"summary":637,"editorNote":285,"say":638,"date":639,"type":541,"round":619,"src":640,"councilorRound":95},[636],"法制處","提出有網友在網路上扭曲事實，指控議員到警察局施壓，但說明自己並未施壓，要求依據偵察不公開作業辦法，請警局提供有聲影片作為證據。並詢問市長的看法，要求市長好好瞭解本案。","首先說的關係到\n10 月12 日PTT 一名網友AirJordan 對我的指控，他以為他撿到一把槍","2020-10-30",[641],295,{"relatedOrgs":643,"summary":644,"editorNote":285,"say":645,"date":639,"type":541,"round":619,"src":646,"councilorRound":95},[],"鑑於野狗傷人問題，支持市府動保教育園區政策，但卻遭民眾攻擊。","接下來就是我在動保園區那一段，我在動保園區的議題被造謠約2 個月，講難聽一\n點",[647],299,{"relatedOrgs":649,"summary":650,"editorNote":285,"say":651,"date":652,"type":541,"round":653,"src":654,"councilorRound":95},[],"詢問學甲動保教育園區是否有要填土石及級配，要求盡速規畫並舉辦說明會","主席、市長、各科室局長及媒體，市長，我請教一下","2020-06-23",3,[655],881,{"relatedOrgs":657,"summary":658,"editorNote":285,"say":659,"date":652,"type":541,"round":653,"src":660,"councilorRound":95},[],"反駁第六公墓撿骨不完全之指控","不然都在說填土石是有給我好處，錢全部都進到我口袋",[655],{"relatedOrgs":662,"summary":663,"editorNote":285,"say":664,"date":665,"type":541,"round":653,"src":666,"councilorRound":95},[],"詢問國慶煙火選址考量，建議將軍漁港","非常感謝，主席、黃市長、方秘書長、各局處的局長、媒體，大家早安大家好","2020-06-10",[667],554,{"relatedOrgs":669,"summary":671,"editorNote":285,"say":672,"date":665,"type":541,"round":653,"src":673,"councilorRound":95},[670],"農業局","反映學甲動物保護教育園區民眾陳情抗議，要求針對民眾訴求回復並說明規劃方案","接下來講學甲動物保護教育園區，有時候問題一大堆",[674],555,{"relatedOrgs":676,"summary":677,"editorNote":285,"say":678,"date":665,"type":541,"round":653,"src":679,"councilorRound":95},[670],"要求學甲動物保護教育園區方案確認後至學甲地區開說明會","你剛才說有規劃1 公頃的公園，如果有臭味是在公園運動的人先聞到",[680],557,{"relatedOrgs":682,"summary":683,"editorNote":285,"say":684,"date":665,"type":541,"round":653,"src":685,"councilorRound":95},[630,670],"詢問設置太陽能板區域設置動保教育園區是否合法","我們這個教育園區好慘，人家反對在我們這裡，想拉去其他區",[686],558,{"relatedOrgs":688,"summary":690,"editorNote":285,"say":691,"date":665,"type":541,"round":653,"src":692,"councilorRound":95},[689],"政風處","要求政風處長把關學甲動物保護教育園區案，避免案件政治化、汙名化","市長剛剛說的我第一屆當議員就跟賴市長說了，保護動物我贊同",[693],559,{"relatedOrgs":695,"summary":696,"editorNote":285,"say":697,"date":665,"type":541,"round":653,"src":698,"councilorRound":95},[630],"詢問學甲市場三角窗改建部分進度","接下來這個學甲市場新建案從我當鎮長開始就一直改建，現在剩三角窗部分還沒改建",[699],561,{"relatedOrgs":701,"summary":702,"editorNote":285,"say":703,"date":665,"type":541,"round":653,"src":704,"councilorRound":95},[],"要求學甲市場應加裝LED燈，可用於宣導政令","局長請坐，我當鎮長的時候大家認為這棟市場的環境衛生需要改善",[705],562,{"relatedOrgs":707,"summary":708,"editorNote":285,"say":709,"date":710,"type":541,"round":711,"src":712,"councilorRound":95},[670],"感謝市府積極處理農地最近的蟲害問題，請市府繼續跟進，並建議與農委會協商休耕補助，防治蟲害蔓延到不可收拾。","首先，最近媒體報導很多的秋行軍蟲，差不多 20天前將軍就發現了","2019-11-05",2,[713],256,{"relatedOrgs":715,"summary":717,"editorNote":285,"say":718,"date":710,"type":541,"round":711,"src":719,"councilorRound":95},[716],"交通局","學甲區有一件交通號誌故障，通報半年後才修理好，以前也有試過等8個月才修好的，質疑原因為何。要求改善情況，不要讓議員和民眾覺得市府不重視臺南縣。","交通局，交通號誌如閃紅燈或閃黃燈，學甲有一件號誌故障",[720],257,{"relatedOrgs":722,"summary":723,"editorNote":285,"say":724,"date":710,"type":541,"round":711,"src":725,"councilorRound":95},[],"反映學甲區公園少，而且兒童遊樂設施不足。","市長，學甲的公園比較少，有個華宗公園還有一個兒童公園，兒童公園的設施",[726],258,{"relatedOrgs":728,"summary":729,"editorNote":285,"say":730,"date":710,"type":541,"round":711,"src":731,"councilorRound":95},[566],"反映東陽國小的冷氣已經23年了，愈修理愈差，之前跟教育部提及，只得到「研議」的回應，質疑換新的冷氣遙遙無期。","第三件，東陽國小，這是個案，所以我在大會講，偏遠的國小也需要活動中心",[726],{"relatedOrgs":733,"summary":734,"editorNote":285,"say":735,"date":710,"type":541,"round":711,"src":736,"councilorRound":95},[566],"華宗盃是學甲區每年的象徵性的活動，但區內就連體育場地也缺乏，建議市長爭取新建一個室內排球館，或是多功能體育館，地點可以是天仁工商旁邊約0.6公頃的閒置市府地。","第四，華宗盃。市長你今年剛好沒空，你剛上任 10 個月",[737],259,{"relatedOrgs":739,"summary":740,"editorNote":285,"say":741,"date":710,"type":541,"round":711,"src":742,"councilorRound":95},[614,615],"華宗盃是行銷臺南的好時機，適逢文化局舉辦的藝術進區大概會在同期舉行，建議配合華宗盃辦個選手之夜。","市長，一個華宗盃有 5,000 多人進到臺南市，賴清德市長時我也講，我們要進到地主之誼",[743],260,{"relatedOrgs":745,"summary":746,"editorNote":285,"say":747,"date":710,"type":541,"round":711,"src":748,"councilorRound":95},[602],"連接學甲區和將軍區的華宗橋因為缺乏維護，很多盞燈都壞了，要求修繕，並且加強燈飾變化。","第五項，之前賴市長的時候我有建議，華宗橋的拱橋。",[749],261,{"relatedOrgs":751,"summary":752,"editorNote":285,"say":753,"date":710,"type":541,"round":711,"src":754,"councilorRound":95},[],"七股區的南33-1線整條道路龜裂嚴重，要求盡快改善，確保用路人安全。","第六項，七股南 33-1 線道路幾乎全線都壞掉了，這個接台 17 線。",[755],262,{"relatedOrgs":757,"summary":758,"editorNote":285,"say":759,"date":710,"type":541,"round":711,"src":760,"councilorRound":95},[602],"學甲區南53線連接臺19線的道路，因為出口很窄，容易發生事故，詢問工務局工程的進度。","局長，南 53 線現在的進度是怎樣？我一直都很關心。",[761],263,{"relatedOrgs":763,"summary":764,"editorNote":285,"say":765,"date":710,"type":541,"round":711,"src":766,"councilorRound":95},[630],"詢問學甲區學甲市場的空地新建工程，市府預計何時進場施工。","再來學甲市場，我當議員剛好 9 年，老是忙這個市場。",[761],{"relatedOrgs":768,"summary":769,"editorNote":285,"say":770,"date":771,"type":541,"round":772,"src":773,"councilorRound":95},[],"要求原縣區成立農漁業小組，幫助產業發展。","所以本席質詢時間要和市長探討，尤其北門區也是農漁業重鎭","2019-05-06",1,[774],507,{"relatedOrgs":776,"summary":777,"editorNote":285,"say":778,"date":771,"type":541,"round":772,"src":779,"councilorRound":95},[],"華宗盃排球比賽規模擴大，場地不敷使用，應興建相關球場，並藉此行銷台南。","學甲華宗盃今年已經40 屆了，我當鎮長的時候，一年差不多都200 隊",[780],508,{"relatedOrgs":782,"summary":783,"editorNote":285,"say":784,"date":771,"type":541,"round":772,"src":785,"councilorRound":95},[],"學甲蜀葵文化應多推廣，編列更多經費，帶動如燈會之地方發展。","市長，說到學甲的蜀葵，以前蜀葵種植非常辛苦，你請坐。",[786],510,{"relatedOrgs":788,"summary":789,"editorNote":285,"say":790,"date":771,"type":541,"round":772,"src":791,"councilorRound":95},[602],"詢問南53線建設進度。","另外南53 線，請工務局長說一下進度。",[792],512,{"relatedOrgs":794,"summary":795,"editorNote":285,"say":796,"date":771,"type":541,"round":772,"src":797,"councilorRound":95},[],"產業道路破損嚴重，應編列更多經費處理。","向市長報告，北門區其實也是農漁業重鎮，很多產業道路已破損得很嚴重",[792],{"relatedOrgs":799,"summary":800,"editorNote":285,"say":801,"date":771,"type":541,"round":772,"src":802,"councilorRound":95},[630],"詢問學甲菜市場改建進度。","菜市場部分已經拖延很久，從本席擔任鎮長開始到現在",[803],513,{"relatedOrgs":805,"summary":806,"editorNote":285,"say":807,"date":771,"type":541,"round":772,"src":808,"councilorRound":95},[],"要求處理流浪狗傷人事件。","近年民意高漲，網路的部分很重要，動保處處長、市長，去看看網路這則新聞",[803],{"org":810},[811,813,814,815,816,817,818,819,820,821,822,823,824],{"name":602,"count":812},5,{"name":630,"count":812},{"name":670,"count":619},{"name":566,"count":619},{"name":590,"count":653},{"name":614,"count":711},{"name":615,"count":711},{"name":578,"count":711},{"name":716,"count":772},{"name":689,"count":772},{"name":636,"count":772},{"name":547,"count":772},{"name":553,"count":772},1793620016559]