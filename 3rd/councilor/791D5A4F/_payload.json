99,805,813,819,825,833,839,846,852,858,864,870,876,882,887,893,899,905,910,914,920,926,934,941,947,954,962,968,974,979,987,993,998,1004,1010,1016,1022,1028,1034,1042,1048,1054,1060,1065,1071],{"relatedOrgs":537,"summary":538,"editorNote":285,"say":539,"date":540,"type":541,"round":542,"src":543,"councilorRound":95},[],"針對成大醫學院的事件發生後，建議市長要提防衛福部長陳時中","成大醫學院的事件發生後，記者會人家採訪他時他竟然說聽起來有違法，有沒有違 法不是他說了算，聽起來有違法的說法讓下面衛生局的壓力很大，好像不能不罰。","2021-11-19","定期會",6,[544],832,{"relatedOrgs":546,"summary":548,"editorNote":285,"say":549,"date":550,"type":541,"round":542,"src":551,"councilorRound":95},[547],"都發局","質疑都發局長及市長不該將社會住宅放在台南市中西區的精華區地帶？","不、不、不。在過去這 10 年，我們臺灣多四十幾萬人，但是臺南市減少約 1 萬 2,000 人，這 10 年來。你上任這 2 年，大概減少 1 萬 9,200 人。當然遷移有特殊的原因，臺北 市有一個很亮眼的叫做明倫社會住宅，你知道它一個月租多少嗎?","2021-11-01",[552],418,{"relatedOrgs":554,"summary":557,"editorNote":285,"say":558,"date":550,"type":541,"round":542,"src":559,"councilorRound":95},[555,556],"工務局","社會局","提出台南市假日塞車，詢問市長、工務局長、社會局長如何透過各種不同的交通方式緩解塞車","我跟你說，未來 輕軌也好、捷運也好，臺南市既然要做，那是 10 年後的事情，但是現在每逢假日就塞車， 所以你用一個替代運輸這麼簡單，這個你沒辦法理解，你不了解我的想法嗎?大家都要 開車進來，當然就塞車。",[560],428,{"relatedOrgs":562,"summary":563,"editorNote":285,"say":564,"date":565,"type":541,"round":566,"src":567,"councilorRound":95},[],"質疑備詢台沒有隔板","感謝主席。主席，為什麼備詢臺沒有隔板？現在是市長都不用出來備詢就對了？","2021-08-04",5,[568],839,{"relatedOrgs":570,"summary":572,"editorNote":285,"say":573,"date":565,"type":541,"round":566,"src":574,"councilorRound":95},[571],"教育局","反映市長對於奧運的關心要多仔細，名字寫錯很不應該","對，選手奪金後要在網路上蹭熱度，結果連名字都寫錯，真的有在關心體育嗎！要用心，獎金該提高的要提高，像我跟蔡氏體育用品合辦了 10 年",[568],{"relatedOrgs":576,"summary":579,"editorNote":285,"say":580,"date":565,"type":541,"round":566,"src":581,"councilorRound":95},[577,578,556],"警察局","民政局","建議市長多下鄉關心被疫情影響的民眾","有件事情我要給你肯定，因為國民黨不斷建議要發現金，我知道國民黨建議的蘇貞昌蘇院長是絕對不肯的，因此我質詢的時候我建議發券不要發現金",[582],840,{"relatedOrgs":584,"summary":586,"editorNote":285,"say":587,"date":588,"type":541,"round":566,"src":589,"councilorRound":95},[585],"衛生局","建議爭取中央防疫補助預算經費及發放每人5000元振興券","可憐基層的苦命人，首先我今天要和你探討的是這些人為何命苦？這些都是你的子民，你是父母官，所以我今天跟你探討一些問題，有檢討也有期待。首先我感謝貴府中西區跟北區的公所，協助我在前兩個星期發送1 萬個便當。","2021-07-14",[590],280,{"relatedOrgs":592,"summary":593,"editorNote":285,"say":594,"date":588,"type":541,"round":566,"src":595,"councilorRound":95},[585],"質疑台南市政府就中央防疫政策有無積極作為爭取編列補助預算與開放解封政策討論","你再向媒體朋友傳送。你代表臺南市民的聲音，代表這些赤腳羅漢、販夫走卒來反映民情，民間的苦情！你可能不了解，因為在民間雖然我們都有接觸，我是不知道你跟我接觸的層級、層面有沒有一樣？",[596],283,{"relatedOrgs":598,"summary":599,"editorNote":285,"say":600,"date":588,"type":541,"round":566,"src":601,"councilorRound":95},[585,571],"詢問幼教業者受疫情影響倒閉情形、疫苗施打站營運狀況、瑞德西偉審核進度及疫苗分配數量","變成在網路上大家對你正面的認同與聲量沒有上去，這很可惜，做對的事情仍然要適度宣傳。你知不知道現在這些軍公教沒有受到影響，但是幼兒園、托兒所，這些私立的……",[602],286,{"relatedOrgs":604,"summary":606,"editorNote":285,"say":607,"date":608,"type":541,"round":566,"src":609,"councilorRound":95},[605],"環保局","建議延長時間給民眾一些適應新的政策，多宣導少開罰","感謝主席，局長，你這個是隨水費徵收嗎","2021-05-04",[610],1838,{"relatedOrgs":612,"summary":614,"editorNote":285,"say":615,"date":616,"type":541,"round":566,"src":617,"councilorRound":95},[613],"文化局","要求要做到活化赤崁園區提升周圍的經濟發展","局長，你有開車來上班嗎？ 赤崁園區是全臺灣古蹟重中之重","2021-04-30",[618],1560,{"relatedOrgs":620,"summary":621,"editorNote":285,"say":622,"date":623,"type":541,"round":624,"src":625,"councilorRound":95},[547],"指出廠商陳情投標時廠商符合資格，市府卻不願意開標，後來又重新開標，並更改招標公告內容。","我要講的這個案子是個公告案，也是臺南市都是更新很重要的案\n子","2020-11-20",4,[626],869,{"relatedOrgs":628,"summary":629,"editorNote":285,"say":630,"date":623,"type":541,"round":624,"src":631,"councilorRound":95},[],"指出臺南市青年住宅的需求與雙北不同，多數年輕人北飄、在地則大部分有房可住。建議思考安南區國宅更新，創造土地和住宅。","臺南市可以開發建設的很多，尤其住宅的問題，青年住宅也好，社會住宅也好",[632],870,{"relatedOrgs":634,"summary":635,"editorNote":285,"say":636,"date":623,"type":541,"round":624,"src":637,"councilorRound":95},[],"要求針對學校竄根的路樹進行列管，並盤點需要樹木移植、開闢公園的重劃區，盤點後從這些進行移植。","剛才許議員提到學校路樹的情況那麼嚴重，包括未來要怎麼做，我在這邊就向你說\n要怎麼解決了。",[638],871,{"relatedOrgs":640,"summary":641,"editorNote":285,"say":642,"date":623,"type":541,"round":624,"src":643,"councilorRound":95},[],"反映前幾天提供的市長任內善款使用資料有誤。且指出未用完的善款若用舊條例硬去用會用不完。","那天質詢，我拿了一個總表來，我\n對你說2 億。你上任後，善款2 年花了2 億",[638],{"relatedOrgs":645,"summary":647,"editorNote":285,"say":648,"date":649,"type":541,"round":624,"src":650,"councilorRound":95},[646],"勞工局","反映學甲內口罩國家隊工廠「格安德」有勞工陳情，要求勞工局會後瞭解問題。","我比你更緊張，我緊張臺南市的治安不好、市政不好，","2020-11-17",[651],757,{"relatedOrgs":653,"summary":654,"editorNote":285,"say":655,"date":649,"type":541,"round":624,"src":656,"councilorRound":95},[],"詢問尋找慰安婦銅像安置位置的進度。","市長，半年前，你在議事廳答應我要用半年的時間思考慰安婦阿嬤銅像的安置地點",[651],{"relatedOrgs":658,"summary":659,"editorNote":285,"say":660,"date":649,"type":541,"round":624,"src":661,"councilorRound":95},[],"要求不要將原總圖廢除、刪減其編制與藏書，應將其作為創始館。","再來，市立圖書館即將要開幕，本席接受臺南二中師生一體陳情",[662],758,{"relatedOrgs":664,"summary":665,"editorNote":285,"say":666,"date":649,"type":541,"round":624,"src":667,"councilorRound":95},[],"批評行政院長干預NCC，要求市長在院會對此事發言。","接下來，美國福斯電視可以說\n是對川普最捧場的",[662],{"relatedOrgs":669,"summary":670,"editorNote":285,"say":671,"date":649,"type":541,"round":624,"src":672,"councilorRound":95},[],"批評市府認定部分住戶沒有證據顯示為地震受災戶，無法得到慰問金一事。並指工務局長對議員的回應不應該。要求將善款使用明細送交議會。","，剛才周議員說的那麼客氣，\n0206 善款在你上任那天還剩下18 億6,000 萬元。",[673],759,{"relatedOrgs":675,"summary":676,"editorNote":285,"say":677,"date":649,"type":541,"round":624,"src":678,"councilorRound":95},[555],"指臺南農地工廠多，市府沒政策對應。","我對你印象很不錯，但是最近這3 個月以來，對你也有些不捨，唉！",[679],760,{"relatedOrgs":681,"summary":682,"editorNote":285,"say":683,"date":649,"type":541,"round":624,"src":684,"councilorRound":95},[],"以爐碴案為例，奉勸市長交友謹慎。","俗語說「仁義莫交財，交財仁義絕」，錢人人要，但要謹慎，與你交陪不是因為黃偉\n哲好相處",[685],762,{"relatedOrgs":687,"summary":688,"editorNote":285,"say":689,"date":649,"type":541,"round":624,"src":690,"councilorRound":95},[],"批評民進黨市長初選提早兩年開始。","尤其當治安事件發生時，坦白說，造成臺南市的不幸，什麼不幸？",[691],763,{"relatedOrgs":693,"summary":694,"editorNote":285,"say":695,"date":649,"type":541,"round":624,"src":696,"councilorRound":95},[],"指出過去不斷提及中華西路路面需要鋪設柏油但被推託。兩年後終於施工，但完工不久後竟又開挖。","另外這條路，我跟你講2 年了，終於在2 個月前做了。",[691],{"relatedOrgs":698,"summary":699,"editorNote":285,"say":700,"date":649,"type":541,"round":624,"src":701,"councilorRound":95},[],"建議市長進行人事異動。","2 年到了，這次的定期大會，我建議你在人事上要稍微異動一下，",[691],{"relatedOrgs":703,"summary":704,"editorNote":285,"say":705,"date":649,"type":541,"round":624,"src":706,"councilorRound":95},[555],"指出新北市的路燈採用智能LED燈，損壞時可自動通報。建議鼓勵民間參與公眾建設，讓LED廠競標，將路燈換成智能LED，再用省下來的電費付給廠商。","經過這次的治安事件後，將路燈改成LED，連路燈長短也能發新聞稿",[691],{"relatedOrgs":708,"summary":709,"editorNote":285,"say":710,"date":649,"type":541,"round":624,"src":711,"councilorRound":95},[],"指出高鐵站附近人煙罕至，野狗多，會讓取車的人感到害怕。","我從高鐵下來\n後要去阿裕牛肉，結果開錯路",[712],764,{"relatedOrgs":714,"summary":716,"editorNote":285,"say":717,"date":649,"type":541,"round":624,"src":718,"councilorRound":95},[715],"交通局","針對安平的假日塞車問題，建議採用假日接駁，在外圍實施停車管制。","你知道安平嗎？我們倆去看看，一到假日車塞到開不出來，我跟你建議",[719],765,{"relatedOrgs":721,"summary":722,"editorNote":285,"say":723,"date":649,"type":541,"round":624,"src":724,"councilorRound":95},[],"質疑武聖夜市的學校用地沒有徵收，某人剛買入過後，就立刻變更用地。質疑是裡應外合。建議參考蘇南成市長的作法。","臺南市公共設施保留地，你上任後解編了多少？",[725],766,{"relatedOrgs":727,"summary":728,"editorNote":285,"say":729,"date":649,"type":541,"round":624,"src":730,"councilorRound":95},[585],"詢問除了檢驗中心外，臺南還有哪些地方可以檢驗萊克多巴胺，並詢問檢驗中心的人力資源是否充足。","未來將在1 月1 日進口美豬，吃了含萊克多巴胺的豬肉後對人的影響",[731],767,{"relatedOrgs":733,"summary":734,"editorNote":285,"say":735,"date":649,"type":541,"round":624,"src":736,"councilorRound":95},[],"批評騎樓人行道政策執行成效差。","你們答應我要做騎樓人行道，才做300、400 公尺，比賴清德做的還差",[737],769,{"relatedOrgs":739,"summary":741,"editorNote":285,"say":742,"date":743,"type":541,"round":624,"src":744,"councilorRound":95},[740],"地政局","批評臺南市土地標售定價太高，導致人民買不起房、繳不起稅。","陳局長我請教你，在臺南市土地標售的定價，你扮演什麼角色？","2020-10-20",[745],2324,{"relatedOrgs":747,"summary":748,"editorNote":285,"say":749,"date":743,"type":541,"round":624,"src":750,"councilorRound":95},[547],"質疑市長親近利益，護航不符合投標資格的廠商，原應由別的廠商得標的標案重新發包。","很多案件，現在土地正「熱」，公共設施用地、停車場用地也能變成建地？學校用地\n也能變建地？",[751],2325,{"relatedOrgs":753,"summary":754,"editorNote":285,"say":755,"date":756,"type":541,"round":624,"src":757,"councilorRound":95},[555],"批評中華西路的柏油路補平的工程沒有先做，導致機車發生事故。","首先我問一下中華西路的柏油路，那時候是誰答覆我的？","2020-10-19",[758],2200,{"relatedOrgs":760,"summary":761,"editorNote":285,"say":762,"date":756,"type":541,"round":624,"src":763,"councilorRound":95},[555],"批評騎樓整平的成果不佳，要求提供預算編列資料，會請志工去走一趟。","你向議會報告說你總共鋪 125 公里的騎樓，騎樓怎麼做？",[758],{"relatedOrgs":765,"summary":766,"editorNote":285,"say":767,"date":768,"type":541,"round":624,"src":769,"councilorRound":95},[715],"要求假日時觀光區要有接駁規劃，以捷運路線為基礎養客。不要將停車場直接劃設在古蹟旁。要求提出解決安平假日人潮的規劃報告。","我請教在座的行政官員，2 年內曾經在假日開車進到安平\n區的舉手","2020-10-13",[770],2102,{"relatedOrgs":772,"summary":774,"editorNote":285,"say":775,"date":776,"type":541,"round":624,"src":777,"councilorRound":95},[773],"農業局","由於很多農產品通路商和貿易商看到包裝廠有意見，要求提供有設置外銷的包裝廠資料。","感謝主席，局長，臺南市所有的農產品外銷，有幾個包裝廠的裝設、設備能夠外銷\n的？今年以","2020-10-07",[778],1656,{"relatedOrgs":780,"summary":781,"editorNote":285,"say":782,"date":783,"type":541,"round":624,"src":784,"councilorRound":95},[613],"詢問美術館開館至今的收藏品有多少，是否包含陳澄波、劉獅的作品。","請教一下館長，現在美術館收藏品的採購是誰？委員會有參加嗎？","2020-10-06",[785],1613,{"relatedOrgs":787,"summary":788,"editorNote":285,"say":789,"date":783,"type":541,"round":624,"src":790,"councilorRound":95},[613],"要求在新總圖設立後，公園路圖書館不應降為地方館，人員和藏書都不能減少。建議可比照美術館，設立1館、2館。","圖書館長我請教你，年底臺南市立圖書館新總館要開館\n了，局長有答應我，現在有多少行政人員？多少服務民眾的人員？總共多少人？",[791],1615,{"relatedOrgs":793,"summary":794,"editorNote":285,"say":795,"date":796,"type":541,"round":624,"src":797,"councilorRound":95},[578],"詢問是否有要求新進同仁拜訪議員。","局長，請問一下，你說有請同仁要新任用要拜訪議員嗎？","2020-09-29",[798],1261,{"relatedOrgs":800,"summary":801,"editorNote":285,"say":802,"date":796,"type":541,"round":624,"src":803,"councilorRound":95},[578],"詢問今年登革熱宣導經費，並建議可以透過議員服務處發送傳單。","我要請教大家，因\n為今年登革熱沒有本土案例，只有國外進來5 例，區公所今年有派人出去宣導登革熱的\n請舉手，一年公所編多少預算？宣導的部分花多少錢？局長，你知道嗎？",[804],1262,{"relatedOrgs":806,"summary":808,"editorNote":285,"say":809,"date":810,"type":541,"round":624,"src":811,"councilorRound":95},[807],"研考會","介紹中華民國領土，並批評民進黨的兩岸政策。","戴主委，請問一下您說兩岸小組是在您的的單位嗎?","2020-09-25",[812],989,{"relatedOrgs":814,"summary":815,"editorNote":285,"say":816,"date":810,"type":541,"round":624,"src":817,"councilorRound":95},[807],"批評黃市長面對網路負面評價時指其為網軍操作。","那我們現在來談談不是政治問題，但是您用政治手段在\n對付人家，最近有人說有公關公司在網路上扭曲抹黑黃偉哲市長，你知道嗎?。",[818],990,{"relatedOrgs":820,"summary":821,"editorNote":285,"say":822,"date":810,"type":541,"round":624,"src":823,"councilorRound":95},[807],"指出前瞻基礎建設經費砍半原因是要補償網軍的方法。","你來 2 個月，是從哪裡來的?你來這邊之前是在哪裡?",[824],991,{"relatedOrgs":826,"summary":827,"editorNote":285,"say":828,"date":829,"type":541,"round":830,"src":831,"councilorRound":95},[],"反映中西區已完成86%汙水下水道接管但排水溝仍有惡臭，要求盡速改善","感謝主席。市長請教一下，中西區是我們觀光景點最多的地方","2020-06-23",3,[832],846,{"relatedOrgs":834,"summary":835,"editorNote":285,"say":836,"date":829,"type":541,"round":830,"src":837,"councilorRound":95},[],"反映廠商在安定區設置高汙染產業混凝土廠竟無須環評，質疑是否官商勾結，要求重點快速調查","大臺南市的市長，你看這是什麼？臺南縣，那個紅色的點叫做邊陲地帶",[838],847,{"relatedOrgs":840,"summary":841,"editorNote":285,"say":842,"date":843,"type":541,"round":830,"src":844,"councilorRound":95},[],"質疑紓困程序不便民，市長不應現場作秀「頒獎」發放補紓困金，應直接到區公所督促收件","尤其市長表現步錯，作秀、頒獎","2020-06-02",[845],299,{"relatedOrgs":847,"summary":848,"editorNote":285,"say":849,"date":843,"type":541,"round":830,"src":850,"councilorRound":95},[],"質疑台南市中華西路道路不平整於一年前質詢時已提出，是否因為市府不作為導致保固逾期，市府要額外支出處理","我播一段影片給你看，大約20秒，這段路途讓你欣賞一下",[851],300,{"relatedOrgs":853,"summary":854,"editorNote":285,"say":855,"date":843,"type":541,"round":830,"src":856,"councilorRound":95},[],"反映疫情原因，建議市場租金遲繳之滯納金取消","你去表演紓困，雖然是作秀，百姓的期待達到極高點的時候",[857],301,{"relatedOrgs":859,"summary":860,"editorNote":285,"say":861,"date":843,"type":541,"round":830,"src":862,"councilorRound":95},[],"反映赤崁文化園區改造工程因為開挖出土多處遺跡可能無法進行，致使成功國小復校遙遙無期","這是赤嵌樓的外圍，我上午去拍的，站在赤崁樓的樓頂",[863],302,{"relatedOrgs":865,"summary":866,"editorNote":285,"say":867,"date":843,"type":541,"round":830,"src":868,"councilorRound":95},[],"建議赤崁文化園區停車場改設置在西門路與民族路口，可活化商圈","成功國小是一百多年的國小，這麼多校友回來，找不到一間母校",[869],303,{"relatedOrgs":871,"summary":872,"editorNote":285,"say":873,"date":843,"type":541,"round":830,"src":874,"councilorRound":95},[613],"建議赤崁文化園區工程不要再繼續開發，就遺構部分改成博物館與赤崁樓連結，讓成功國小盡快復學","國華街所有的商場，這些整個都會活起來",[875],305,{"relatedOrgs":877,"summary":878,"editorNote":285,"say":879,"date":843,"type":541,"round":830,"src":880,"councilorRound":95},[],"反映赤崁文化園區工程拖延影響周邊商機","因為現在赤崁樓前面這樣挖，我剛剛也給你看了",[881],306,{"relatedOrgs":883,"summary":884,"editorNote":285,"say":885,"date":843,"type":541,"round":830,"src":886,"councilorRound":95},[],"反映赤崁文化園區工程施工未有專家派駐，無法辨別是否為遺跡","怎麼會不拖遲，早上我去的時候，他們看到我趕緊就說，小力一點",[881],{"relatedOrgs":888,"summary":889,"editorNote":285,"say":890,"date":843,"type":541,"round":830,"src":891,"councilorRound":95},[605],"反映823水災參與救援之車主因城西掩埋場道路陷落致車體損壞，原李孟諺代理市長承諾台南市府負全責，嗣後申請國賠卻遭拒。法院判決亦為天災因素可無須國賠。要求市長處理","你們所有針對遺跡、遺構的鑑定會議紀錄，拜託你知會本會",[892],307,{"relatedOrgs":894,"summary":895,"editorNote":285,"say":896,"date":843,"type":541,"round":830,"src":897,"councilorRound":95},[605],"詢問台南市下水道是否皆已盤查，是否登錄在案的下水道即為所有的下水道","就是請他來做的人竟然沒有幫他保險，這也違背災害防治法",[898],309,{"relatedOrgs":900,"summary":901,"editorNote":285,"say":902,"date":843,"type":541,"round":830,"src":903,"councilorRound":95},[605],"要求提供下水道資料進行複查，並鼓勵退休公務員協助補充未登錄的下水道資訊","你把資料公告出來，再提供給本席，我們就會叫人複查",[904],310,{"relatedOrgs":906,"summary":907,"editorNote":285,"say":908,"date":843,"type":541,"round":830,"src":909,"councilorRound":95},[],"批評市長提出赦免陳水扁前總統之建議","你竟然說要特赦一個貪汙的陳水扁總統，身為中華民國的總統",[904],{"relatedOrgs":911,"summary":912,"editorNote":285,"say":908,"date":843,"type":541,"round":830,"src":913,"councilorRound":95},[],"質疑罷免韓國瑜的理由，依現在的標準只是對韓國瑜不爽而已，是否同樣可以因為不爽罷免市長",[904],{"relatedOrgs":915,"summary":916,"editorNote":285,"say":917,"date":843,"type":541,"round":830,"src":918,"councilorRound":95},[],"批評市長執政不佳，反映多人鼓勵更替市長","沒有大幅度進步的團隊，沒有讓台南市能夠發光發亮",[919],312,{"relatedOrgs":921,"summary":922,"editorNote":285,"say":923,"date":843,"type":541,"round":830,"src":924,"councilorRound":95},[],"台南市慰安婦人權平等促進協會捐贈慰安婦銅像給市府，要求市長尋找適當地點安置，並於下次總質詢(11月)時回復","這樣是台南市的市民比較理性嗎?相對高雄市民，不是這樣的",[925],313,{"relatedOrgs":927,"summary":929,"editorNote":285,"say":930,"date":931,"type":541,"round":830,"src":932,"councilorRound":95},[928],"經發局","詢問是否取消今年度市場未繳租金的滯納金，建議市府裁量不開單即可，要求在會期內答覆","感謝主席，請教局長，擔蔥賣菜的販夫走卒都很辛苦","2020-05-18",[933],1516,{"relatedOrgs":935,"summary":936,"