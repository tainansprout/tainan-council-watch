616,621,627,633,639,646,653,659,665,671,676,681,687,693,698,703,710,718,724,730,736,742,748,754,760,766,772,778,783,789,796,802,809,815,821,828,834,840,847],{"relatedOrgs":539,"summary":540,"editorNote":285,"say":541,"date":542,"type":543,"round":544,"src":545,"councilorRound":95},[],"針對前瞻基礎建設，批評國民黨抹黑，建議應該不分黨派來支持前瞻基礎建設","今天利用可能是最後一次的自由發言時間來說一下前瞻建設，聽聞有議會同事對前瞻建設的誤導，其實我真的覺得很遺憾，前瞻建設真的非常重要，所以本席利用自由發言時間向市民釐清前瞻建設特別預算被誤導的誤會。","2019-11-25","定期會",2,[546],807,{"relatedOrgs":548,"summary":549,"editorNote":285,"say":550,"date":542,"type":543,"round":544,"src":551,"councilorRound":95},[],"針對前瞻計畫，詢問市長未來要怎麼努力","剛提到前瞻計畫，我想剩 1 分鐘請市長回答一下，針對前瞻計畫我們市府未來要怎麼努力。",[552],810,{"relatedOrgs":554,"summary":555,"editorNote":285,"say":556,"date":557,"type":543,"round":544,"src":558,"councilorRound":95},[],"永康區「康橋大道」已經開闢完成但還未通車，應該是受旁邊的砲校工程拖延，而舊砲校的拆卸和新砲校的興建也落後市政府之前允諾的時程，詢問市長可否允諾以上工程會於2024年完成，趕及成為「臺南建成四百年」的亮點。","講到「康橋大道」，現在已經開闢完成但還未通車，我想應該是因為旁邊的砲校整體開發問題","2019-11-06",[559],273,{"relatedOrgs":561,"summary":562,"editorNote":285,"say":563,"date":557,"type":543,"round":544,"src":564,"councilorRound":95},[],"建議透過都市計畫或其他手段，銜接永康區的忠孝路和康橋大道，連成一條南北貫通的主要幹道。","剛剛也有提到忠孝路要銜接康橋大道的問題，因為康橋大道未來如果通車，它的重點在於可以往北銜接正南三路、正南六街跨鹽水溪大橋到安南區",[565],274,{"relatedOrgs":567,"summary":569,"editorNote":285,"say":570,"date":557,"type":543,"round":544,"src":571,"councilorRound":95},[568],"工務局","詢問永康區忠孝路拓寬工程的進度。","這部分我想簡單問一下進度，工務局蘇局長，忠孝路拓寬一事目前進度為何？",[565],{"relatedOrgs":573,"summary":575,"editorNote":285,"say":576,"date":557,"type":543,"round":544,"src":577,"councilorRound":95},[574,568],"都發局","忠孝運動公園的土地因預設為墓地，以致不能在上面建體育設施，詢問將能解決此問題的「二王公墓市地重劃案」，何時會公告可變更成體育用地的部分。","再來，我長期以來一直關心的就是「忠孝運動公園」，所謂的「二王公墓市地重劃案」",[578],276,{"relatedOrgs":580,"summary":582,"editorNote":285,"say":583,"date":557,"type":543,"round":544,"src":584,"councilorRound":95},[581],"教育局","詢問未來忠孝運動公園土地變更成體育用地後，教育局有否預算改善與擴充公園整體和壘球場的設施。","教育局局長，這部分你們有沒有預算要處理？打算要用多少預算來處理忠孝壘球場？",[578],{"relatedOrgs":586,"summary":587,"editorNote":285,"say":588,"date":557,"type":543,"round":544,"src":589,"councilorRound":95},[],"建議在「二王公墓市地重劃案」的第二期市地重劃，規劃青年公宅，往「智慧綠能新社區」方向規劃，並且加入公托、日照的公共設施。","這是第二期市地重劃，螢幕上斜線的部分，要提醒市長，勿忘當初我們承諾年輕人要蓋「青年公宅」",[590],277,{"relatedOrgs":592,"summary":594,"editorNote":285,"say":595,"date":557,"type":543,"round":544,"src":596,"councilorRound":95},[593,568],"交通局","詢問幾個重要交通建設的進度，包括永康區鐵路地下化、新市區和善化區高架化、北外環道是否可以銜接國一並增設匝道和捷運藍線。","另外永康有一些很重要的交通建設，我也要趁這個機會關心、檢視一下進度，包括永康鐵路地下化及新市高架化的進度",[590],{"relatedOrgs":598,"summary":600,"editorNote":285,"say":601,"date":557,"type":543,"round":544,"src":602,"councilorRound":95},[599,568],"水利局","詢問永康區三爺溪治水的進度，相關工程包括鯽潭橋段護岸整治、萬代橋拓寬，萬代橋下游清淤疏濬。","講到交通建設，永康還有一件很重要的事情就是治水，治水就仰賴這三個很重要的進程",[603],279,{"relatedOrgs":605,"summary":606,"editorNote":285,"say":607,"date":557,"type":543,"round":544,"src":608,"councilorRound":95},[599],"詢問整個三爺溪整治工程還需要多少經費，其中欠缺多少。","所以整個三爺溪整治工程未來還需要多少經費？",[603],{"relatedOrgs":610,"summary":612,"editorNote":285,"say":613,"date":557,"type":543,"round":544,"src":614,"councilorRound":95},[611],"經發局","建議在佳里區開闢「番仔寮工業區」，打造「國八產業廊道」，讓南科聚落產業完整化。","我覺得如果用這角度來看，也就是從所謂打造「國八產業廊道」的觀點來看，其實我們還需要一個「番仔寮工業區」",[615],283,{"relatedOrgs":617,"summary":618,"editorNote":285,"say":619,"date":557,"type":543,"round":544,"src":620,"councilorRound":95},[],"詢問南科擴編計畫是否會執行在新市區看西農場，並建議市府與中央配合，盡快促成南科擴編計畫。","講到聚落旁邊的工業區開發，當然就要講到南科本身。南科的擴編",[615],{"relatedOrgs":622,"summary":623,"editorNote":285,"say":624,"date":557,"type":543,"round":544,"src":625,"councilorRound":95},[599],"就南科三期擴編計畫，為了爭取發展在臺南，建議市府做好包括治水在內的準備，向中央展示臺南真的準備好。","可是剛才市長也說有地勢低窪的問題，市府團隊當然要做好準備包括治水在內，在看西農場基地要做好相關的治水計畫",[626],284,{"relatedOrgs":628,"summary":629,"editorNote":285,"say":630,"date":557,"type":543,"round":544,"src":631,"councilorRound":95},[568],"為爭取南科三期擴展計畫留在臺南，建議發展「樹谷大道南延計畫」，使大道延伸至看西農場，完善交通配套。","另外除了治水還有交通，本席建議市府要提出「樹谷大道南延計畫」，延伸至看西農場，這部分請蘇局長說明。",[632],285,{"relatedOrgs":634,"summary":635,"editorNote":285,"say":636,"date":557,"type":543,"round":544,"src":637,"councilorRound":95},[574],"新市區的都市計畫區只佔整區6.5%，建議規劃擴大都市計畫區，吸引更多的南科新貴。","因為新市就在南科，南科就在新市，其實現在新市的都市計畫範圍，相對於整個新市的全區面積",[638],286,{"relatedOrgs":640,"summary":642,"editorNote":285,"say":643,"date":557,"type":543,"round":544,"src":644,"councilorRound":95},[641],"消防局","對於有臺南市消防員被指控於對上常常擺爛，不願進火場救火，詢問市長的看法，及有否應對的淘汰機制。","我想要先請教市府，因為今早臺南有一則新聞報導說，有人舉報我們臺南市某消防分隊的李姓女消防員",[645],290,{"relatedOrgs":647,"summary":649,"editorNote":285,"say":650,"date":557,"type":543,"round":544,"src":651,"councilorRound":95},[648],"觀旅局","詢問新化區虎頭埤青年活動中心改建為星級飯店的進度。","再來我要跟市府探討的就是今天一開始我所提及的新化，新化其實是一個山區觀光的大門戶-「山城入口」",[652],291,{"relatedOrgs":654,"summary":655,"editorNote":285,"say":656,"date":557,"type":543,"round":544,"src":657,"councilorRound":95},[648],"新化區虎頭埤風景優美，適合打造成觀光旅遊景點，建議向西拉雅風景管理處爭取經費改善虎頭埤設施，並且一併改善南168線廊道，再設置網美打卡點。","其實虎頭埤的風景非常優美，常常吸引許多民眾到此遊憩，不過內部許多設備都呈現老舊狀態",[658],292,{"relatedOrgs":660,"summary":662,"editorNote":285,"say":663,"date":557,"type":543,"round":544,"src":664,"councilorRound":95},[661],"文化局","建議串聯左鎮化石園區、山上花園水道博物館、新市南科考古館及大內天文館，為這山區四大館推行套票，鼓勵民眾遊覽更多經典，過夜留宿，活化區內整個觀光旅遊業。","山區目前有新增的四大館是一個亮點，就是左鎮化石園區、山上花園水道博物館、新市南科考古館及大內天文館",[658],{"relatedOrgs":666,"summary":667,"editorNote":285,"say":668,"date":557,"type":543,"round":544,"src":669,"councilorRound":95},[648],"建議市長在臉書行銷11月8日在新化區公所舉辦的民宿申辦說明會。","另外我知道 11 月 8 日在新化區公所，有觀旅局舉辦的民宿申辦說明會，要鼓勵年輕人來新化辦理民宿",[670],293,{"relatedOrgs":672,"summary":673,"editorNote":285,"say":674,"date":557,"type":543,"round":544,"src":675,"councilorRound":95},[],"建議興南客運轉運站搬到原新化果菜市場，並把其規劃成複合式的轉運站，有公共運輸、停車場、農特產品及商場等服務。","新化果市場目前已經遷移，這塊土地到底要做何使用？",[670],{"relatedOrgs":677,"summary":678,"editorNote":285,"say":679,"date":557,"type":543,"round":544,"src":680,"councilorRound":95},[593],"建議評估拓寬銜接永康區西勢和新化區崙仔頂的新灣橋的可能性，以應付地方交通需求。","另外本席要建議的是，永康西勢銜接新化崙仔頂有一個新灣橋，目前是 15 米寬",[670],{"relatedOrgs":682,"summary":684,"editorNote":285,"say":685,"date":557,"type":543,"round":544,"src":686,"councilorRound":95},[683],"社會局","建議在永康區及新市區中間興建一個旗艦型親子遊樂空間，讓外縣市的家長都會特地帶孩子來遊玩，把臺南變成友善親子的標竿城市。","另外要來談教育體育親子議題，這也是我長期關心的議題，特別是永康這邊",[670],{"relatedOrgs":688,"summary":689,"editorNote":285,"say":690,"date":557,"type":543,"round":544,"src":691,"councilorRound":95},[581],"要求教育局加緊增設公立幼兒園，以應付需求。","再來是我長期關注且每次總質詢都會提出的增設公幼議題，謝謝市政府在增設公幼上一直在努力當中，市政府也推動「幼教三箭」",[692],295,{"relatedOrgs":694,"summary":695,"editorNote":285,"say":696,"date":557,"type":543,"round":544,"src":697,"councilorRound":95},[581],"臺南目前是六都中體育處員額跟編制最弱的，要求提升體育編制，市長把設立「體育局」視做未來施政的重要目標。","再來我要力促提升體育編制，設立「體育局」，因為我們與其他六都相較，體育處員額跟編制是最弱的",[692],{"relatedOrgs":699,"summary":700,"editorNote":285,"say":701,"date":557,"type":543,"round":544,"src":702,"councilorRound":95},[],"建議為臺灣將要踏入超高齡社會做好準備，例如推行人性化的安養機構設施、居家養老（Home care）、「長青志工團」，尊重老人同時減輕壯年人負擔。","剛才我講完幼兒議題，現在當然就要說到老人，因為再過不久，臺灣就要走入超高齡社會",[692],{"relatedOrgs":704,"summary":706,"editorNote":285,"say":707,"date":557,"type":543,"round":544,"src":708,"councilorRound":95},[705],"環保局","反映學校在回收廚餘前要自行處理瀝出來的油水，造成學校人員的負擔，建議請清潔隊將油水一併收走。","最後我用30秒時間來說廚餘處理問題，學校營養午餐的廚餘其實還算大量，現在是由清潔隊回收廚餘",[709],296,{"relatedOrgs":711,"summary":712,"editorNote":285,"say":713,"date":714,"type":543,"round":715,"src":716,"councilorRound":95},[581],"公幼需求嚴重不足，要求市府增設公幼。","針對現在少子化是國安危機，各地方政府都想要鼓勵年輕人生育","2019-04-22",1,[717],155,{"relatedOrgs":719,"summary":720,"editorNote":285,"say":721,"date":714,"type":543,"round":715,"src":722,"councilorRound":95},[581],"在人口稠密區公幼老師要多開缺，增加正式老師比例，減少流動率。","教師控管比在人口稠密區太高，目前就我瞭解還有20%",[723],157,{"relatedOrgs":725,"summary":726,"editorNote":285,"say":727,"date":714,"type":543,"round":715,"src":728,"councilorRound":95},[683],"希望能打造民間規格、公家收費的親子悠遊館旗艦店。","再來要請問市長，臺南有沒有公營的遊戲親子空間？",[729],158,{"relatedOrgs":731,"summary":732,"editorNote":285,"say":733,"date":714,"type":543,"round":715,"src":734,"councilorRound":95},[581],"廢除行政教師免超額政策，尊重學校的人事決定權，並推動行政減量。","另外想跟大家提的是校園行政體系，我覺得這件事情很重要",[735],159,{"relatedOrgs":737,"summary":738,"editorNote":285,"say":739,"date":714,"type":543,"round":715,"src":740,"councilorRound":95},[581],"市府應盡速簽訂與教師工會的團體協約，賦予教師工會權利，並促進雙方合作。","另外，我再提一個比較嚴肅的問題，就是團體協約",[741],160,{"relatedOrgs":743,"summary":744,"editorNote":285,"say":745,"date":714,"type":543,"round":715,"src":746,"councilorRound":95},[],"推動三級棒球發展，建議成立大灣高中棒球隊。","好，謝謝市長、局長。接下來講到我最愛的棒球",[747],161,{"relatedOrgs":749,"summary":750,"editorNote":285,"say":751,"date":714,"type":543,"round":715,"src":752,"councilorRound":95},[],"希望能在合法範圍內想出一套照顧鄰長的方式。","先請教民政局局長，聽說最近檢調有在關心鄰長津貼的事情",[753],164,{"relatedOrgs":755,"summary":756,"editorNote":285,"say":757,"date":714,"type":543,"round":715,"src":758,"councilorRound":95},[],"要再更支持台南在地職棒隊伍統一獅。","繼續請教市長，剛剛延續到棒球議題，上個月我有陪賴清德前院長進球場看統一獅的球賽",[759],165,{"relatedOrgs":761,"summary":762,"editorNote":285,"say":763,"date":714,"type":543,"round":715,"src":764,"councilorRound":95},[],"詳盡規劃新化及周遭地區的觀光發展方案。","另外我想要和市府團隊討論一下新化老街整個文化觀光產業推廣的問題。",[765],166,{"relatedOrgs":767,"summary":768,"editorNote":285,"say":769,"date":714,"type":543,"round":715,"src":770,"councilorRound":95},[705],"希望跨局處能解決非洲豬瘟造成校園廚餘處理問題。","因為非洲豬瘟的關係，廚餘變成有點棘手的問題",[771],167,{"relatedOrgs":773,"summary":774,"editorNote":285,"say":775,"date":714,"type":543,"round":715,"src":776,"councilorRound":95},[],"建議把城市音樂廳放在總圖基地附近，打造文化綠廊。","另外我想要和大家探討一下永康新都心的問題，永康新都心在砲校的基地",[777],168,{"relatedOrgs":779,"summary":780,"editorNote":285,"say":781,"date":714,"type":543,"round":715,"src":782,"councilorRound":95},[],"二王公墓市地重劃後建議規劃體育用地及青年住宅。","我們再提到二王公墓的市地重劃案，砲校基地對面就是二王公墓",[777],{"relatedOrgs":784,"summary":785,"editorNote":285,"say":786,"date":714,"type":543,"round":715,"src":787,"councilorRound":95},[568],"建議康橋大道南方忠孝路拉直及拓寬。","最後要跟大家提到所謂的康橋大道，我們整個砲校基地的第一期已經有開闢一條15 米的康橋大道",[788],169,{"relatedOrgs":790,"summary":791,"editorNote":285,"say":792,"date":793,"type":543,"round":715,"src":794,"councilorRound":95},[593],"詢問永康鐵路地下化的目前進度","所以要請教局長，永康鐵路地下化的進程到底如何？","2019-04-15",[795],1779,{"relatedOrgs":797,"summary":798,"editorNote":285,"say":799,"date":793,"type":543,"round":715,"src":800,"councilorRound":95},[593],"針對捷運藍線的規劃，詢問未來大橋站到總圖是否會有交通工具接駁","我們現在正在推捷運，捷運處有來永康開捷運說明會，那天的反應基本上贊成的是絕大多數，大家都希望永康這個臺南市人口數最多的地方真的有捷運可以搭乘，方便去其他的地方。",[801],1780,{"relatedOrgs":803,"summary":804,"editorNote":285,"say":805,"date":806,"type":543,"round":715,"src":807,"councilorRound":95},[705],"詢問廚餘生質能源中心目前的進度為何","我想請教廚餘的問題。之前為杜絕非洲豬瘟所以都不用廚餘餵豬。臺南是美食之都， 每天美食小吃在營運過程會產生很多廚餘，以往民間跟政府都會收廚餘。現在民間不收， 政府就得幫忙收，我知道現在環保局打算建廚餘生質能源中心，去年有辦記者會招商，我 們要替百姓解決廚餘問題，做成能源，但是這目前進度為何，我請教局長或邱科長。","2019-04-10",[808],1581,{"relatedOrgs":810,"summary":811,"editorNote":285,"say":812,"date":806,"type":543,"round":715,"src":813,"councilorRound":95},[705],"針對小吃店的廚餘回收問題，建議環保局要建立統一處理的方式，協助他們","有小吃店在反映，一般小吃店當然是靠政府幫他們收，政府會要求小吃店要油水分離，問題是一般小吃店哪有瀝水方面的設備，所以造成營運困難，你們讓這些賣麵賣飯的小吃店如何處理？你讓他們油水分離嗎？",[814],1582,{"relatedOrgs":816,"summary":817,"editorNote":285,"say":818,"date":806,"type":543,"round":715,"src":819,"councilorRound":95},[705],"為了解決臺南市垃圾問題，建議環保局和經發局能夠做好溝通","之前臺南市在報編工業區時，其實我們都有點便宜行事，沒有在報編工業區設焚化廠或掩埋場，專設工業區裏頭企業廢棄物設施，變成事業廢棄物得由永康焚化廠、城西焚化廠、或 掩埋場處理，於是事業廢棄物就沒地方丟，這問題層出不窮",[820],1583,{"relatedOrgs":822,"summary":823,"editorNote":285,"say":824,"date":825,"type":543,"round":715,"src":826,"councilorRound":95},[661],"針對未來設置在永康新總圖的湯德章紀念館，詢問文化局的預期規劃","我要請教一下局長，我們永康新總圖本來預計的工程進度現在如何？","2019-04-03",[827],1345,{"relatedOrgs":829,"summary":830,"editorNote":285,"say":831,"date":825,"type":543,"round":715,"src":832,"councilorRound":95},[661],"針對新化衛生所提報成市定歷史建築，詢問文化局目前進度","另外我想詢問，去年有一些文史工作者對於已經擁有九十多年歷史的新化衛生所要提報成市定歷史建築，可是經我現在查閱目前文化局好像還沒有將它列為文化資產，所以詢問一下，對於這個超過九十年的新化衛生所你們的進度如何？你們的打算是什麼？未來有想要把它列為文化資產嗎？進度如何？",[833],1346,{"relatedOrgs":835,"summary":836,"editorNote":285,"say":837,"date":825,"type":543,"round":715,"src":838,"councilorRound":95},[661],"針對永康社教中心的演藝廳整建，詢問要整建的內容以及預計完成的時間","另外我在總質詢時都有多次提到的永康社教中心圖書館， 也有提到永康社教中心的演藝廳，我看到剛才文化局的報告有提到演藝廳要整建，對不對？",[839],1347,{"relatedOrgs":841,"summary":842,"editorNote":285,"say":843,"date":844,"type":543,"round":715,"src":845,"councilorRound":95},[581],"針對校長遴選委員會，建議校長遴選委員會的教師代表，能夠由教師組織派出","再來要面對一個問題，就是校長遴選委員會的事情，我覺得要相當嚴肅的面對這個課題","2019-04-02",[846],1279,{"relatedOrgs":848,"summary":849,"editorNote":285,"say":850,"date":851,"type":543,"round":715,"src":852,"councilorRound":95},[683],"針對虐童案件，建議社會局多加強對於未婚媽媽和單親媽媽的關懷","謝謝主席。我想請教社會局，沒關係，局長你先請坐，最近新聞常看到虐童案件，甚至我們臺南市也很不幸的，有媽媽打死小孩的事情","2019-03-28",[853],969,{"org":855},[856,858,860,862,864,865,867,868,869,870,871],{"name":581,"count":857},8,{"name":568,"count":859},6,{"name":705,"count":861},5,{"name":661,"count":863},4,{"name":593,"count":863},{"name":683,"count":866},3,{"name":599,"count":866},{"name":648,"count":866},{"name":574,"count":544},{"name":611,"count":715},{"name":641,"count":715},1793544962789]