98,805,811,815,819,823,829,836,841,847,853,858,864,870,875,880,888,895,900,905,911,918,924,929,934,940,945,950,956,961,967,973,980,987,995,1001,1006,1012,1019,1025,1030,1038,1043,1049,1054,1060,1066,1072,1078,1084,1089,1095,1102,1108,1114,1119,1125,1132],{"relatedOrgs":537,"summary":539,"editorNote":285,"say":540,"date":541,"type":542,"round":543,"src":544,"councilorRound":95},[538],"文化局","詢問文化局為何國父銅像豎立問題因為尚未取得社會共識擱置","第一個問題，國父銅像的豎立， 經過你許可後，文化局局長、文資處及外聘委員這樣辛苦，經過一段時間的會勘、評估、 考量之下，最後的結果是 110 年 2 月 22 日在文資處的會議室拍板定案，出席委員全數通 過，那天的會議是文化局長葉澤山主持的，局長是不是?","2021-11-12","定期會",6,[545],746,{"relatedOrgs":547,"summary":548,"editorNote":285,"say":549,"date":541,"type":542,"round":543,"src":550,"councilorRound":95},[],"因為都更問題日益重要，希望市府設置都更二級機關，包括處理社會住宅及青年住宅，另外也希望體育處升格為體育局","好，謝謝局長，局長請坐。我希望藉由這個自由發言的時間，也可以跟市長請命， 關於未來的都更方面，目前都市更新科的科員員額僅有 17 位，臺北市、新北市都有所謂 都市更新的專責局處，甚至高雄也正由營建署輔導成立相關的單位，未來我們的都更有 沒有可能也成立一個二級機關?因為我們都知道所謂的都市更新是非常專業的項目，包 含市區更新改造、民間自辦更新案、更新開發審查管理以及產業的振興活化，甚至是掌 控房屋價格是否有高漲等，我想這些都非常專業。即便是身為議員的本席，也僅知道皮 毛而已，沒辦法深入，所以我希望未來如果可能的話，可以成立一個專責單位，是不是 請市長說明一下?",[551],750,{"relatedOrgs":553,"summary":555,"editorNote":285,"say":556,"date":541,"type":542,"round":543,"src":557,"councilorRound":95},[554],"警察局","希望警察局的事故現場草圖需要一些時間繪製，員警無法在現場進行正式繪圖，繪圖結果也不盡人意，希望能改善製圖","就你所瞭解這張圖是什麼東西，你有看過嗎? 出車禍的時候會有這樣的一張表。\n",[558],755,{"relatedOrgs":560,"summary":561,"editorNote":285,"say":562,"date":541,"type":542,"round":543,"src":563,"councilorRound":95},[],"白河蓮農洗耦粉量不好，市長回應加強行銷，以及天災救助","白河蓮農今年的產量不好，尤其是我們要洗藕粉時，需要很多阿姨、大哥用刨的把 粉刨下來，大家都在怨嘆今年洗藕粉的量不好，還好價格穩定，如果像這種狀況，市長 你想怎麼處理呢?",[564],757,{"relatedOrgs":566,"summary":568,"editorNote":285,"say":569,"date":570,"type":542,"round":543,"src":571,"councilorRound":95},[567],"教育局","詢問校園霸凌防範","這是最近臺南市某女子高中受霸凌的問題，這幾天我們也跟教育局做反映，我們要讓教育局和市長知道學校的霸凌問題。學生在成長當中難免有少部分的學生會產生這樣私底下的報復或是處理的事情，從這個事件以後，不只在臺南市，未來在整個全國，在校園管理辦法的規則或是規範，有沒有辦法去著手一個比較好的防範措施","2021-10-20",[572],119,{"relatedOrgs":574,"summary":576,"editorNote":285,"say":577,"date":570,"type":542,"round":543,"src":578,"councilorRound":95},[575],"工務局","要求提升危樓管理嚴謹度","我在這裡也要特別請教市長，市長你先坐。現在全國的風暴，老舊的大樓荒廢或是少數的住戶在使用，現況裡面都沒有管理委員會，產生很多的盲點，行政單位現在有訂下來大廈管理委員會，這樣的條例是已經有來申請或是新的我們來輔導的，但是這些老舊的住戶已經有部分的流離，有一部分還是在那裡，我們怎麼樣來訂定一個輔導辦法？讓他能夠上路，上路以後能夠妥善管理",[579],121,{"relatedOrgs":581,"summary":583,"editorNote":285,"say":584,"date":570,"type":542,"round":543,"src":585,"councilorRound":95},[582],"地政局","督促自辦海岸進度","臺南市從合併以後的自辦重劃，目前原地主簽了同意書重劃以後，現在還沒有辦法分配到土地使用，大概數據有多少？幾個區塊",[586],127,{"relatedOrgs":588,"summary":589,"editorNote":285,"say":590,"date":570,"type":542,"round":543,"src":591,"councilorRound":95},[],"詢問國有財產所有權規劃","市長，我再請教你一點，目前國有財產署的土地座落在臺南市現在國有財產署的土地都是朝著只租不賣70 年",[592],130,{"relatedOrgs":594,"summary":595,"editorNote":285,"say":596,"date":597,"type":542,"round":543,"src":598,"councilorRound":95},[554],"質詢非道路用地違規停車舉報問題","謝謝主席。這張照片，","2021-09-28",[599],1152,{"relatedOrgs":601,"summary":603,"editorNote":285,"say":604,"date":605,"type":542,"round":543,"src":606,"councilorRound":95},[602],"衛生局","瞭解計程車業者接踵第一劑疫苗情形及注射疫苗之標準","感謝主席。衛生局局長，這次 COVID19 注射，你知不知道臺南市的計程車駕駛業 者，目前還沒有注射第一劑的有多少，你知道嗎?","2021-09-27",[607],1045,{"relatedOrgs":609,"summary":610,"editorNote":285,"say":611,"date":605,"type":542,"round":543,"src":612,"councilorRound":95},[602],"要求針對列冊高風險職業人員調整接踵第二劑疫苗之行政作業","在疫苗允許的情況下是不是趕快調整腳步、趕快處理？別的縣市已經開始在打第二 劑了。再來就是高風險的，長照、日照、養護中心、婦女之家，原本第一劑是按照高風",[613],1046,{"relatedOrgs":615,"summary":616,"editorNote":285,"say":617,"date":618,"type":542,"round":619,"src":620,"councilorRound":95},[602],"詢問市府對中央疫苗採購政策的看法","謝謝主席。黃市長，我那天請教疫苗的問題，到現在社會都很關心。立法院讓我們很灰心，這次購買疫苗能夠買到 4,000 萬劑，","2021-08-06",5,[621],925,{"relatedOrgs":623,"summary":625,"editorNote":285,"say":626,"date":618,"type":542,"round":619,"src":627,"councilorRound":95},[624,575],"水利局","詢問對於淹水時全市抽水馬達的運作如何，尤其是小東路段","謝謝。再來這幾天都在下雨，小東路地下道這幾天都積水，有時候遇到雨天或是下雨量比較多的時候就會產生這個情況",[621],{"relatedOrgs":629,"summary":631,"editorNote":285,"say":632,"date":618,"type":542,"round":619,"src":633,"councilorRound":95},[630],"經發局","建議維修開元市場的電動手扶梯","經發局局長，開元菜市場是市場管理處的吧？",[634],926,{"relatedOrgs":636,"summary":638,"editorNote":285,"say":639,"date":640,"type":542,"round":619,"src":641,"councilorRound":95},[637,575],"環保局","批評環保局與工務局在執行修剪行道樹的業務干擾到民眾，民眾陳情反映後兩個局卻互踢皮球","謝謝。請將簡報相片播放出來，市長你看一下，這是我們臺南市政府修剪完行道樹後的樹幹和樹枝，把相片全都播放一下讓市長看","2021-07-29",[642],683,{"relatedOrgs":644,"summary":645,"editorNote":285,"say":646,"date":640,"type":542,"round":619,"src":647,"councilorRound":95},[575],"質疑市府特殊規格的大圖影印費用太貴","工務局局長和市長請看一下這兩張圖，左手邊這張是外面所說的「大張」A0，我右手邊這張較小張的是 A1，這兩張是建築圖，市長，為什麼我要拿這兩張給你看",[648],685,{"relatedOrgs":650,"summary":651,"editorNote":285,"say":652,"date":640,"type":542,"round":619,"src":653,"councilorRound":95},[602],"詢問我國疫苗進口量各品牌共進貨多少? 市府有沒有想辦法讓疫苗覆蓋率繼續上升來補足第二劑第三劑的數量","再來，請播放影片，，我要讓大家看，立法院不分何種政黨，從去年新冠肺炎發生，政府掌控民間口罩，國軍進駐及警察進駐管制口罩比武器還嚴格，",[654],687,{"relatedOrgs":656,"summary":657,"editorNote":285,"say":658,"date":640,"type":542,"round":619,"src":659,"councilorRound":95},[567],"建議體育處或教育局能向中央爭取計畫經費，來培養更多台南在地的體育好手，分擔家長的培訓心力","好，謝謝。市長，我們這次在奧運中臺南市的成績也很亮麗。桌球混雙，但我現在的看法是，國家的國光獎金與地方政府發給的獎金都是花得完\n得，出路問題、工作問題，年輕時去拚了，為國家爭光榮得到獎金……\n",[660],690,{"relatedOrgs":662,"summary":663,"editorNote":285,"say":664,"date":640,"type":542,"round":619,"src":665,"councilorRound":95},[575],"詢問之前關於機車位代金的公文進度送往內政部的後續流程如何","請教工務局局長，現在 50 平方公尺以上是否規定設一個機車格位？我們現在汽車是可以代金繳納，前陣子議會委員會有通過法規且大會也通過了，",[666],692,{"relatedOrgs":668,"summary":670,"editorNote":285,"say":671,"date":672,"type":542,"round":619,"src":673,"councilorRound":95},[669],"農業局","建議向中央反應太陽能綠能政策讓農地面積縮小會是嚴重的問題","感謝主席。農業局，我想在地方政府對中央政府應該適當的反應","2021-05-03",[674],1688,{"relatedOrgs":676,"summary":677,"editorNote":285,"say":678,"date":672,"type":542,"round":619,"src":679,"councilorRound":95},[630],"建議鼓勵民間參與招商投資","在招商部分，我們一直在推動工業區開發及招商，但我們面臨很多地方性的問題",[674],{"relatedOrgs":681,"summary":683,"editorNote":285,"say":684,"date":685,"type":542,"round":686,"src":687,"councilorRound":95},[682],"民政局","針對鄰長自強活動以代金5000元發放一事，要求在市長任內，要延續此政策規劃。","市長，我想請問鄰長的自強活動，今年是最後一次，明年是要用5,000 元\n的代金，是不是？","2020-11-20",4,[688],864,{"relatedOrgs":690,"summary":691,"editorNote":285,"say":692,"date":685,"type":542,"round":686,"src":693,"councilorRound":95},[],"指出建設經費等物資提高，建議將里長的修繕費由每年13萬調整為20萬。","還要請教市長，每年里長的13 萬，可以處理這些雜七雜八\n的里長自主性的修繕費。市長，明年的經費有沒有可能增加",[694],865,{"relatedOrgs":696,"summary":697,"editorNote":285,"say":698,"date":685,"type":542,"round":686,"src":699,"councilorRound":95},[],"反映社區的監視器損壞嚴重，且行政用的社區監視系統與警察的系統無法銜接，要求對此進行檢討。","第三點，市長，市區裡的監視器。",[700],866,{"relatedOrgs":702,"summary":703,"editorNote":285,"say":704,"date":685,"type":542,"round":686,"src":705,"councilorRound":95},[],"要求成立專責小組，將會竄根、傷害人行道的路樹移植到腹地較大的地方。","請市長、工務局成立一個專責小組，每個國小的人行道以及樹，日積月累，\n樹都已經很大",[706],867,{"relatedOrgs":708,"summary":709,"editorNote":285,"say":710,"date":711,"type":542,"round":686,"src":712,"councilorRound":95},[],"指自己反對美豬進口，理由包含：1. 台灣豬終於可出口，要直線成長的階段，和進口美豬會互相衝突。2. 過去法律要求養豬戶不得使用萊克多巴胺，卻因為要進口美豬而更改過去的規定。3. 進口前沒有規劃和配套，是拿人民健康開玩笑。4. 進口後的流向管理缺乏制度。","首先我針對美豬進口的反對意見，現在坦白講，美豬進口是執政者\n下的一個不正當且對我們國人健康沒有做合理交代的政策","2020-10-26",[713],144,{"relatedOrgs":715,"summary":716,"editorNote":285,"say":717,"date":711,"type":542,"round":686,"src":718,"councilorRound":95},[637],"質疑委外家戶垃圾清運業者是否可能夾帶事業廢棄物垃圾進焚化爐。","好！那我請問一下環保局局長。",[719],145,{"relatedOrgs":721,"summary":722,"editorNote":285,"say":723,"date":711,"type":542,"round":686,"src":724,"councilorRound":95},[637],"指出在政府經濟鮭魚返鄉政策下，事業廢棄物增加，處理量能不足，詢問未來如何面對垃圾問題。指出焚化爐能燒的量在萎縮，要求積極思考蓋新的焚化爐和掩埋場的計畫，並詢問老舊焚化爐的處理方式。","再來，我們現在的垃圾量每年在增加，是不是？",[725],147,{"relatedOrgs":727,"summary":728,"editorNote":285,"say":729,"date":711,"type":542,"round":686,"src":730,"councilorRound":95},[637],"質疑臨時土方堆置場的數量眾多，但卻都不是取得真正許可證運轉的堆置場。","再來一個問題，土方堆積場問題，環保局的法令是可以設置\n臨時土方堆置場",[731],151,{"relatedOrgs":733,"summary":734,"editorNote":285,"say":735,"date":711,"type":542,"round":686,"src":736,"councilorRound":95},[567],"詢問多元教學的課程規劃形式，以及學生是否有成長學習卡。建議在多元教學中導入學生自填的選項，記錄學生在不同課程中的學習時數。","請問一下，目前我們在國小、國中每週過去的時代叫做課外活動",[737],152,{"relatedOrgs":739,"summary":740,"editorNote":285,"say":741,"date":711,"type":542,"round":686,"src":742,"councilorRound":95},[567],"質疑多元化教學的內容不夠務實。","當然我們再講回來，局長有提供給我多元化教學裡面的內容，坦白講，有一些單項很抽象、不務實",[743],156,{"relatedOrgs":745,"summary":746,"editorNote":285,"say":747,"date":711,"type":542,"round":686,"src":748,"councilorRound":95},[567],"要求要有方法讓學生練字，建議在國小、國中、高中的基礎教育中，讓學生每週寫作文練習寫字。","好，局長，既然我有心要問你了，就再問你一樣，現在我\n們國小、國中有作文嗎？",[743],{"relatedOrgs":750,"summary":751,"editorNote":285,"say":752,"date":711,"type":542,"round":686,"src":753,"councilorRound":95},[],"指台鐵出軌意外與派遣制度有關，政府不願意花錢培養正式人員，只用派遣充人數。希望在牽涉專業方面，要花錢培養人才。","接下來我再提到一個問題，我剛講到制度面，那我就要提到的是今天公布了\n臺鐵出軌案要追究過去的檢修人員",[754],157,{"relatedOrgs":756,"summary":757,"editorNote":285,"say":758,"date":759,"type":542,"round":686,"src":760,"councilorRound":95},[575],"肯定在大型公園下開闢有電梯的地下停車場。詢問未來還有多少類似規劃的地下停車場，要求要和交通局跨局處合作。","我特別肯定你這幾年來在我們大型公園\n開闢了很多地下室的停車場，且有附設電梯","2020-10-19",[761],2155,{"relatedOrgs":763,"summary":764,"editorNote":285,"say":765,"date":759,"type":542,"round":686,"src":766,"councilorRound":95},[575],"要求重新設定工程單價，讓一直流標的工程（如長榮路、公園路一帶挖箱涵的工程）可以順利進行。","我這邊給局長幾個建議，最近民眾反應為什麼我們的\n工程單價有時會發包不出去？",[767],2156,{"relatedOrgs":769,"summary":770,"editorNote":285,"say":771,"date":759,"type":542,"round":686,"src":772,"councilorRound":95},[575],"要求盡快開闢北門路三段延伸到永康中華路的20米道路。","還有我向局長報告一下，\n最近我提了幾個案子也是民眾陳情的",[767],{"relatedOrgs":774,"summary":775,"editorNote":285,"say":776,"date":759,"type":542,"round":686,"src":777,"councilorRound":95},[575],"反應永康區小北路12號至64號道路沒有新做側溝，碰到下雨就積水，要求盡快處理。","我那天也邀請工務局、區公所及里長到永康區小北路12 號至64 號道路側溝會勘，\n民眾向我們反應只要一下雨道路就會積水",[767],{"relatedOrgs":779,"summary":780,"editorNote":285,"say":781,"date":759,"type":542,"round":686,"src":782,"councilorRound":95},[624],"要求水利局改善污水孔施工","最後，希望水利局污水孔不要施工完後就很靜音，不要每次下完\n雨後要維修時",[767],{"relatedOrgs":784,"summary":786,"editorNote":285,"say":787,"date":788,"type":542,"round":789,"src":790,"councilorRound":95},[785],"勞工局","反映產業因疫情致外籍移工新舊無法交接，人力不足，移工政策不合里，要求向勞動部反映檢討","感謝主席。勞工局局長，我請教你一個問題，企業中的外藉移工因時間到了需要回國","2020-06-29",3,[791],915,{"relatedOrgs":793,"summary":794,"editorNote":285,"say":795,"date":788,"type":542,"round":789,"src":796,"councilorRound":95},[],"質疑兒少法修法是鼓勵犯罪，建議要從嚴立法","這是企業很大的心聲，局長請坐。市長，我剛提到這個問題",[797],917,{"relatedOrgs":799,"summary":800,"editorNote":285,"say":801,"date":802,"type":542,"round":789,"src":803,"councilorRound":95},[624],"反映北區轉運站淹水問題，原因除過去管線施工不良再加上公共工程施工導致廢水區集中，國防部又已將土地出租，應如何解決","感謝主席。黃市長、方秘書長，以及在座的市政府各位主管","2020-06-15",[804],620,{"relatedOrgs":806,"summary":807,"editorNote":285,"say":808,"date":802,"type":542,"round":789,"src":809,"councilorRound":95},[567,575],"要求行道樹總體檢，應主動審試樹木狀況，有必要就修剪","當然事先他們是有講說他們會來做，這個部分地主上來說可能是疏忽掉了",[810],622,{"relatedOrgs":812,"summary":813,"editorNote":285,"say":808,"date":802,"type":542,"round":789,"src":814,"councilorRound":95},[567,575],"呼籲護樹聯盟應理性溝通，不要將市府修剪樹木認定是亂砍樹",[810],{"relatedOrgs":816,"summary":817,"editorNote":285,"say":808,"date":802,"type":542,"round":789,"src":818,"councilorRound":95},[567,575],"建議思考行道樹種類或綠化方式，避免種植後造成公共設施危險",[810],{"relatedOrgs":820,"summary":821,"editorNote":285,"say":808,"date":802,"type":542,"round":789,"src":822,"councilorRound":95},[567],"詢問延平國中路樹倒塌理賠狀況",[810],{"relatedOrgs":824,"summary":825,"editorNote":285,"say":826,"date":802,"type":542,"round":789,"src":827,"councilorRound":95},[575],"詢問示範道路的定義，除爭取經費較方便外，是否有其他管制與區別","對，不只是學校，要呼籲市長，在哪個區塊?哪個角落",[828],624,{"relatedOrgs":830,"summary":832,"editorNote":285,"say":833,"date":802,"type":542,"round":789,"src":834,"councilorRound":95},[831],"交通局","質疑中華西路列為示範道路後取消路邊停車格不合理","對，我跟你講，局長你請坐。過去的生活圈道路",[835],625,{"relatedOrgs":837,"summary":838,"editorNote":285,"say":839,"date":802,"type":542,"round":789,"src":840,"councilorRound":95},[831],"建議若因示範道路要取消停車格，應在鄰近腹地設置停車位作為配套","有部分是有停車位，但現在全線沒有一個路邊停車格",[835],{"relatedOrgs":842,"summary":843,"editorNote":285,"say":844,"date":802,"type":542,"round":789,"src":845,"councilorRound":95},[831],"建議公部門可用閒置土地開發為停車場，不應依賴民間進行","我們獎勵民間這樣開發土地，一塊地都很多錢。如果地主願意就減稅",[846],626,{"relatedOrgs":848,"summary":849,"editorNote":285,"say":850,"date":802,"type":542,"round":789,"src":851,"councilorRound":95},[],"反映台南市火車站列為古蹟，兩側腹地僅做為民間招商放機車，未整體規劃","黃線的話也是一個思考，紅線你就不能停車，市長感謝",[852],628,{"relatedOrgs":854,"summary":855,"editorNote":285,"say":856,"date":802,"type":542,"round":789,"src":857,"councilorRound":95},[],"建議台南火車站周邊可以結合地方需求、整體規劃，以求帶動地方商圈","我剛剛講的就是停車問題、商圈問題，未來我們怎麼樣結合中央、地方",[852],{"relatedOrgs":859,"summary":860,"editorNote":285,"say":861,"date":802,"type":542,"round":789,"src":862,"councilorRound":95},[],"建議評估台南火車站前圓環是否適合設置地下停車場","我另外有一個想法，雖然我在建築方面也不是很專業",[863],629,{"relatedOrgs":865,"summary":866,"editorNote":285,"say":867,"date":802,"type":542,"round":789,"src":868,"councilorRound":95},[],"建議民族路腹地建設立體停車場以消化車輛","對，交通流量很大，但是在南側以前的庫房",[869],630,{"relatedOrgs":871,"summary":872,"editorNote":285,"say":873,"date":802,"type":542,"round":789,"src":874,"councilorRound":95},[],"詢問是否有針對疫情緩和後經濟復甦計畫","再來一點，新冠肺炎使各行各業都受創，我在這裡也要請教市長",[869],{"relatedOrgs":876,"summary":877,"editorNote":285,"say":878,"date":802,"type":542,"round":789,"src":879,"councilorRound":95},[],"詢問市長對於台南市未來的建設與規劃想法","一年半將近兩年，未來對整個臺南市溪南溪北，整個臺南市的大方向",[869],{"relatedOrgs":881,"summary":882,"editorNote":285,"say":883,"date":884,"type":542,"round":885,"src":886,"councilorRound":95},[682],"建議市府能夠思考要如何用刺激性的、比較有效的政策來激勵人口成長、針對同婚登記，詢問是否有明確的定位記載","延伸剛剛張議員播放的影片，這幾天我 line 的族群也有收到，我有看，但不會轉傳。看了後開始思考一個問題，張議員有提到，參加喜宴敬酒的時候都會說百年好合、早生貴子，你的想法和我一樣。當我看到這個影片，聽了好幾遍以後，面臨到新的考驗，如果不認同要怎麼包紅包？敬酒時要說什麼？","2019-11-22",2,[887],769,{"relatedOrgs":889,"summary":891,"editorNote":285,"say":892,"date":884,"type":542,"round":885,"src":893,"councilorRound":95},[890],"秘書處","針對民眾到市政府洽公但停車位不足，建議能夠利用閒置空地，再開闢比較好的停車空間，或是先規劃簡易停車場，讓洽公民眾有停車空間","再來第二點建議，民眾到市政府洽公，現在車輛太多，停車位真的不足，是不是思考一下，目前西側廣場，就是靠近永華路這邊，這是民眾給的提議，可否利用一些空地，在法律許可或政府規劃之下，再開闢一些比較好的停車空間，方便市民來洽公，不然拖吊很嚴重，進來洽公辦事情又找不到車子，花錢又捨不得，還要浪費很多時間，針對這個問題目前有沒有比較好的因應對策？",[894],770,{"relatedOrgs":896,"summary":897,"editorNote":285,"say":898,"date":884,"type":542,"round":885,"src":899,"councilorRound":95},[831],"針對立體停車場，詢問交通局目前的規劃進度，也建議交通局將中華西路車流較多的問題，一併納入檢討","交通局長，現在停車場的規劃進度怎麼樣？",[894],{"relatedOrgs":901,"summary":902,"editorNote":285,"say":903,"date":884,"type":542,"round":885,"src":904,"councilorRound":95},[831],"針對臺南市火車站的停車問題，建議交通局能夠思考如何在不妨礙交通的情況下，增加臨時停車空間，方便民眾接客和送客","再來也是民眾一直反映的，臺南市火車站的停車問題，以及正在施工的鐵路地下化。針對火車站停車問題，本席一直在思考如何解決，比如說去接客人也好，或是送客人去坐車也好，這邊也請交通局長腦力激盪一下，如何增加一些臨時停車空間，在不妨礙交通的情況下，方便那些接客送客的民眾，這點也請大家腦力激盪一下好不好？",[894],{"relatedOrgs":906,"summary":907,"editorNote":285,"say":908,"date":884,"type":542,"round":885,"src":909,"councilorRound":95},[538],"針對柳科典藏庫的國父銅像，詢問文化局何時能夠把它豎立起來","再者，請市長及文化局幫忙一下，有關國父銅像，目前在柳科的儲藏室裡面。",[910],771,{"relatedOrgs":912,"summary":913,"editorNote":285,"say":914,"date":915,"type":542,"round":885,"src":916,"councilorRound":95},[575,624],"反映北區長德街、長北街淹水問題嚴重，要求水利局和工務局繼續跟進，盡快解決。","請播圖片，為什麼要讓你們看圖片，因為長北街一下雨就會淹水，據我觀察積水很快，淹水的高度大概會有 30 公分高","2019-10-30",[917],115,{"relatedOrgs":919,"summary":920,"editorNote":285,"say":921,"date":915,"type":542,"round":885,"src":922,"councilorRound":95},[831],"詢問為何臺南轉運站完工了還沒開放使用。","還有一點是轉運站，交通局局長，我看轉運站都已經完工了，怎麼還沒開放使用？",[923],117,{"relatedOrgs":925,"summary":926,"editorNote":285,"say":927,"date":915,"type":542,"round":885,"src":928,"councilorRound":95},[831],"詢問為何公園路、臺南轉運站對面的路邊停車格都被取消了。","還有一點請教局長，公園路不是都有很多民間團體辦理捐血嗎？我這幾次去後發現位置改變，你知道嗎？",[923],{"relatedOrgs":930,"summary":931,"editorNote":285,"say":932,"date":915,"type":542,"round":885,"src":933,"councilorRound":95},[831],"詢問原本在臺南火車站前停靠的國道客運，是否都會遷移到轉運站上、下車。","再請問，未來轉運站營運之後，原本在火車站的大巴是保持現狀不動嗎？上、下車不變動？",[572],{"relatedOrgs":935,"summary":936,"editorNote":285,"say":937,"date":915,"type":542,"round":885,"src":938,"councilorRound":95},[831],"北區長榮路地下道封路期間，建議加派人手疏導。","關於長榮路地下道，昨日 29 日已經開始封路了，警察、交通單位都去看了，我個人也去看了，目前狀況都還好",[939],120,{"relatedOrgs":941,"summary":942,"editorNote":285,"say":943,"date":915,"type":542,"round":885,"src":944,"councilorRound":95},[567],"質疑某些國小國中的教材給予學生太多思考空間，不利成長，其中以性別平等教育的教材內容作例子。","再來請教育局，教育局局長，我剛剛有給你們資料，就是這幾年我觀察教改以後的教材問題，我心裡很納悶",[939],{"relatedOrgs":946,"summary":947,"editorNote":285,"say":948,"date":915,"type":542,"round":885,"src":949,"councilorRound":95},[567],"建議在九年國教加強生活教育，而且增加課外教學活動、實際體驗的部分。","小學國教九年教育的時候，沒有戶外教學只有遠足，在大自然裡看了很多拔蘿蔔、蔬菜、水果等等，讓小孩子接觸。",[579],{"relatedOrgs":951,"summary":952,"editorNote":285,"say":953,"date":915,"type":542,"round":885,"src":954,"councilorRound":95},[831],"詢問北區開元轉運站T-Bike腳踏車設置租賃站的進度。","再來請問交通局，我那天提到開元 T-Bike 腳踏車的問題，進展得如何？有沒有方向？",[955],122,{"relatedOrgs":957,"summary":958,"editorNote":285,"say":959,"date":915,"type":542,"round":885,"src":960,"councilorRound":95},[831],"詢問北區和緯路臨時停車場隔壁的荒廢空地，可否也一併整理做停車場，並且建議交通局繼續增設臨時停車場，以回應需求。","局長，再請教一下，和緯路開闢了臨時停車場，我上次跟你報告隔壁的那塊地，現在這塊地是國防部的，你說另一塊地是國有財產局的",[955],{"relatedOrgs":962,"summary":964,"editorNote":285,"say":965,"date":915,"type":542,"round":885,"src":966,"councilorRound":95},[963],"都發局","建議市長向國防部反映，盡快規劃其閒置土地的開發。","再請教市長，臺南市的眷村有很多國防部的用地，希望你可以向國防部反映，很多閒置的空間，就像北門路和和緯路九六新村。",[955],{"relatedOrgs":968,"summary":969,"editorNote":285,"say":970,"date":915,"type":542,"round":885,"src":971,"councilorRound":95},[],"詢問市長對臺南市未來有否大的規劃。","我想問市長，擔任市長以後，對臺南市未來有沒有大的規劃，簡短幾句說明怎麼規劃臺南市、如何規劃為最美的都市或是如何吸引觀光客？請用三分鐘說明一下。",[972],123,{"relatedOrgs":974,"summary":975,"editorNote":285,"say":976,"date":977,"type":542,"round":885,"src":978,"councilorRound":95},[831],"詢問臺南市鐵路地下化工程預定期程與執行狀況以及周邊道路網路規劃。","我要請問交通局長，現在臺南市鐵路地下化的工程正在加緊施工當中，請問臺南市路段所有廠商是否都已經發包出去了？","2019-10-23",[979],1689,{"relatedOrgs":981,"summary":983,"editorNote":285,"say":984,"date":977,"type":542,"round":885,"src":985,"councilorRound":95},[982],"觀旅局","建議增加展演空間以及結合地方特色與街頭藝人辦理定期演出。","有一點請教觀光旅遊局，臺南市有很好的特色，一府二鹿三艋舺，我們有很豐富的古蹟。本席建議觀光旅遊怎麼讓人進來，",[986],1692,{"relatedOrgs":988,"summary":990,"editorNote":285,"say":991,"date":992,"type":542,"round":885,"src":993,"councilorRound":95},[989],"消防局","質疑消防同仁的人身安全、健康權益及辦公環境應更受重視。","消防局李局長，我請教你幾個問題，第一關於我們的消防設備，除了有優質人才外也要有很好的設備，工欲善其事，必先利其器，我有幾點建議，","2019-10-21",[994],1559,{"relatedOrgs":996,"summary":997,"editorNote":285,"say":998,"date":992,"type":542,"round":885,"src":999,"councilorRound":95},[554],"詢問關於校園毒品的預防，是否有有效處理方法。","關於我們現在的治安，有形的是暴力，無形的大概是毒品，毒品現在如此猖獗，我們警界一直說預防勝於治療，",[1000],1561,{"relatedOrgs":1002,"summary":1003,"editorNote":285,"say":1004,"date":992,"type":542,"round":885,"src":1005,"councilorRound":95},[554],"建議監視設備安置在新興區域能提前安置，預防勝於補救。","關於監視器問題，監視器等於是你們撒出去的網，千里眼一般，對你們破案幫助很大，但我們在新發展的地區如重劃區、市府規劃等希望能有配套一併跟上腳步，",[1000],{"relatedOrgs":1007,"summary":1008,"editorNote":285,"say":1009,"date":992,"type":542,"round":885,"src":1010,"councilorRound":95},[554],"詢問第一線員警武器裝備是否足以應付突發狀況。","最後一點，市區暴力發生情形很多，我們的快打部隊效果很好，但快打部隊的大家都很辛苦，我希望除了快打部隊第一時間的支援外，",[1011],1562,{"relatedOrgs":1013,"summary":1014,"editorNote":285,"say":1015,"date":1016,"type":542,"round":885,"src":1017,"councilorRound":95},[669],"反映經環保局廚餘再利用檢核通過可以養豬","請問農業局局長，我看工作報告第7 頁提到養豬場不使用廚餘輔導，據我所知，養\n 豬場經過列管，廚餘煮熟的設備經過政府輔導而且符合的話，廚餘是可以養豬的","2019-10-17",[1018],1367,{"relatedOrgs":1020,"summary":1021,"editorNote":285,"say":1022,"date":1016,"type":542,"round":885,"src":1023,"councilorRound":95},[669],"建議產季水果結合文化、觀光局舉辦文化季","但是我有幾點建議，相關的本地在地的農業如何再活化升級？我建議產季的水果，可以透過行政官方結合文化局、結合觀光旅遊局",[1024],1368,{"relatedOrgs":1026,"summary":1027,"editorNote":285,"say":1028,"date":1016,"type":542,"round":885,"src":1029,"councilorRound":95},[630],"反映工業用地不足，政府應該放購買；另加強推動小北商圈活化","經發局局長，請教一下，現在國土規劃對農地的一些工廠最近都在轉型，本席建議\n 對於中小企業產業的業者而言，坦白講工業區的需求量是不夠的，但是希望妳跟中央反應或是地方也好，我們有效的資源台糖的地也好",[1024],{"relatedOrgs":1031,"summary":1032,"editorNote":285,"say":1033,"date":1034,"type":542,"round":1035,"src":1036,"councilorRound":95},[575],"北區開南街道路開闢問題。","北區的NA-121-12M 就是全段開南街的12 米道路","2019-04-29",1,[1037],344,{"relatedOrgs":1039,"summary":1040,"editorNote":285,"say":1041,"date":1034,"type":542,"round":1035,"src":1042,"councilorRound":95},[575],"台南公園連鎖磚部分建議改劃為停車格。","再來也是工務局的業務，是臺南公園的現況停車問題",[1037],{"relatedOrgs":1044,"summary":1045,"editorNote":285,"say":1046,"date":1034,"type":542,"round":1035,"src":1047,"councilorRound":95},[575],"活動中心蓋在公園預定地上，停車格少，建議增設停車格。","我們有很多公園預定地開闢為公園，過去因為地方上有需求",[1048],345,{"relatedOrgs":1050,"summary":1051,"editorNote":285,"say":1052,"date":1034,"type":542,"round":1035,"src":1053,"councilorRound":95},[831],"開元國小原美國學校舊址規劃為接駁轉運站，地方無法接受委外成大規劃。","開元國小原美國學校舊址要規劃為接駁轉運站",[1048],{"relatedOrgs":1055,"summary":1056,"editorNote":285,"say":1057,"date":1034,"type":542,"round":1035,"src":1058,"councilorRound":95},[567],"培養學生人與人之間的連結教育，學習處世道理。","請鄭局長先坐下，目前臺中市發生因為霸凌導致國中生跳樓",[1059],346,{"relatedOrgs":1061,"summary":1062,"editorNote":285,"say":1063,"date":1034,"type":542,"round":1035,"src":1064,"councilorRound":95},[567],"公權力的強制性對教育有益，太民主的教育對小孩子來說不會成長。","市長在這裡聽，我們的教育框架真的要有公權力而且人性化、合理化的強制性",[1065],348,{"relatedOrgs":1067,"summary":1068,"editorNote":285,"say":1069,"date":1034,"type":542,"round":1035,"src":1070,"councilorRound":95},[963],"詢問北門路九六新村土地規劃運用","臺南市有很多國防部的眷改土地一直擱置著",[1071],349,{"relatedOrgs":1073,"summary":1074,"editorNote":285,"say":1075,"date":1034,"type":542,"round":1035,"src":1076,"councilorRound":95},[],"要求65歲以上老人免繳健保費。","還有65 歲以上長者的健保補助，在財政支出允許下來應編列預算",[1077],350,{"relatedOrgs":1079,"summary":1080,"editorNote":285,"say":1081,"date":1034,"type":542,"round":1035,"src":1082,"councilorRound":95},[],"編列預算做親子悠遊館，應在績效政策大量推動。","接下我要談的是親子悠遊館，為什麼還要提這個",[1083],351,{"relatedOrgs":1085,"summary":1086,"editorNote":285,"say":1087,"date":1034,"type":542,"round":1035,"src":1088,"councilorRound":95},[630],"舊東帝士百貨土地規劃發展問題。","再來要請教經發局局長，小北商圈與新小北商圈",[1083],{"relatedOrgs":1090,"summary":1091,"editorNote":285,"say":1092,"date":1034,"type":542,"round":1035,"src":1093,"councilorRound":95},[],"政府外包造成公共危險，鐵路外包工程要重新檢討。","大家回想一下阿里山的火車出軌，向大家報告，我每一位朋友來",[1094],352,{"relatedOrgs":1096,"summary":1097,"editorNote":285,"say":1098,"date":1099,"type":542,"round":1035,"src":1100,"councilorRound":95},[831],"針對北區兵工廠正在興建的臨時轉運站，建議交通局能夠保留下來，不要再拆掉又重覆興建，這樣很浪費","我們北區兵工廠最近不是在興建轉運站嗎？","2019-04-15",[1101],1789,{"relatedOrgs":1103,"summary":1104,"editorNote":285,"say":1105,"date":1099,"type":542,"round":1035,"src":1106,"councilorRound":95},[831],"針對溪南、溪北的捷運有部分是高架的，詢問未來會不會有地下化","第二，關於這段時間我們要做的捷運，我拜託你在各區辦理相關路線的說明會，對不對？",[1107],1791,{"relatedOrgs":1109,"summary":1110,"editorNote":285,"say":1111,"date":1099,"type":542,"round":1035,"src":1112,"councilorRound":95},[831],"建議交通局針對拖吊公司能夠加強監督和規範","第三點，我們民間的拖吊委外已經告一段落了嘛？",[1113],1792,{"relatedOrgs":1115,"summary":1116,"editorNote":285,"say":1117,"date":1099,"type":542,"round":1035,"src":1118,"councilorRound":95},[982],"針對要活絡中正路商圈，建議觀光局能夠朝海陸方向規劃，結合陸地、海岸線變成一個觀光區","第一，我們中正路的商圈本來 是個很活絡的商圈，現在你看一直沒落下去，店舖也租不出去，人潮也不來了，中國城也已經拆除未來要重蓋，我知道現在廠商也已經進去要做改善了，未來在這方面我希望你們要有規劃和藍圖，以後我們要在那裡做觀光碼頭，結合後變成一個大廣場，希望在中正路 能下點功夫，找回過去活絡的商圈，結合陸地、海岸線成一個觀光區，但要如何延伸？",[1113],{"relatedOrgs":1120,"summary":1121,"editorNote":285,"say":1122,"date":1099,"type":542,"round":1035,"src":1123,"councilorRound":95},[982],"針對濱海公路的船屋，建議觀光局能夠結合陸、海的觀光，並透過陸上古蹟優勢，吸引觀光客","還有我們濱海公路的船屋現在也還擱置在那裡，我們相關法令應適當解編，在招商上才能吸引投標廠商",[1124],1793,{"relatedOrgs":1126,"summary":1127,"editorNote":285,"say":1128,"date":1129,"type":542,"round":1035,"src":1130,"councilorRound":95},[554],"針對校園販毒，詢問警察局該如何處理","看這個狀況怎麼處理，我是民眾，跟你反映某某學校剛好有一群學生，有在販賣糖果， 在學校裡面有進行販賣，我現在要請警方協助到校來逮捕跟處理，請局長這怎麼處理？","2019-04-12",[1131],1657,{"relatedOrgs":1133,"summary":1134,"editorNote":285,"say":1135,"date":1129,"type":542,"round":1035,"src":1136,"councilorRound":95},[554],"針對民眾檢舉某大樓有疑似毒品時，詢問警察局會怎麼處理","第二個狀況，請求我某某大樓幾樓幾號，我們長期兩三個月，在我們的管線空間，我們有聞到有類似毒品，而且陌生的人經常出入，從地下室， 請求治安單位，我們我們當地的保全反映，跟我們這間的反映，大樓管理反映，全部狀況都無效，請警察局是不是來協助處理?這個狀況你怎麼處理?",[1137],1661,{"org":1139},[1140,1142,1144,1146,1148,1149,1150,1151,1152,1153,1154,1155,1156,1157,1158,1159,1160],{"name":575,"count":1141},17,{"name":831,"count":1143},16,{"name":567,"count":1145},13,{"name":554,"count":1147},7,{"name":630,"count":686},{"name":624,"count":686},{"name":637,"count":686},{"name":602,"count":686},{"name":982,"count":789},{"name":669,"count":789},{"name":963,"count":885},{"name":682,"count":885},{"name":538,"count":885},{"name":890,"count":1035},{"name":989,"count":1035},{"name":785,"count":1035},{"name":582,"count":1035},1793544963002]