9,744,748,754,759,764,770,775,780,788,794,801,807,814,821,827,833,839,844,851,859,865,872,878,884,889,895,901],{"relatedOrgs":539,"summary":540,"editorNote":285,"say":541,"date":542,"type":543,"round":544,"src":545,"councilorRound":95},[],"要求東區能增加更多公托幼兒園，並提供誘因及相關協助，鼓勵更多私幼加入準公共化的行列","要求東區能增加更多公托幼兒園之外，更需多提供誘因及相關協助，鼓勵更多私幼加入準公共化的行列，盼能將流失的人口慢慢找回。","2021-11-22","定期會",6,[546],890,{"relatedOrgs":548,"summary":550,"editorNote":285,"say":551,"date":552,"type":543,"round":544,"src":553,"councilorRound":95},[549],"教育局","詢問教育局關於毒品進入校園的問題，但毒品卻一直在校園出現，接觸毒品的年齡層越來越低，再犯率越來越高","再來，同樣和毒有關係，「拒絕毒品進入校園」，如果說到毒品，大家都知道不好，問 10 個人要不要吸毒，大家都會說不要，但是現在毒品的變化層出不窮，我相信政府很用心推 動防毒，拒毒八招包括堅持拒絕法、告知理由法、自我嘲解法、遠離現場法、友誼勸服法、 轉移話題法、反說服法、反激將法","2021-11-09",[554],632,{"relatedOrgs":556,"summary":561,"editorNote":285,"say":562,"date":552,"type":543,"round":544,"src":563,"councilorRound":95},[557,558,559,560],"工務局","都發局","消防局","社會局","希望工務局因城中城火災引起注意，改善複合式大樓公共安全問題","老舊大樓和危老房屋問題，這次城中城的火災事件警示了一些問題，我們要重視。市長， 城中城發生火災的隔天你是不是有帶相關單位和一些議員同事去複合式大樓稽查，展現我們 的決心?",[564],637,{"relatedOrgs":566,"summary":567,"editorNote":285,"say":568,"date":552,"type":543,"round":544,"src":569,"councilorRound":95},[560],"詢問社會局老弱族群安置的問題，有獨老關懷機制，區公所或社會福利服務中心可以協助","社會局局長，這些事情的發生突顯了這邊有一些社會問題，大多 數的人都是經濟弱勢及行動不便的人，是不是針對老舊大樓的弱勢族群民眾，社會局也要加 強關心、了解，以啟動安置措施，或掌握這些人遭遇到的問題。請問，這裡如果有弱勢族群， 現在有什麼因應措施?",[570],640,{"relatedOrgs":572,"summary":573,"editorNote":285,"say":574,"date":552,"type":543,"round":544,"src":575,"councilorRound":95},[558],"針對都發局鐵路地下化，周邊留舊翻新，拆遷住戶及都更都只做半套，對東區居民影響很大，希望工程進度不要再落後","市長，鐵路地下化之後，周邊景觀要如何「留舊翻新」?我為什麼要抓這些 照片呢?過去我和曾培雅議員，我的姑姑，我們都是住在鐵路邊，我在鐵路邊出生的，崇明 路那邊，鐵路地下化後，政府有補助和照顧拆遷戶，已經有部分搬去照顧住宅，另外這些沒 拆到，沒有動到的住宅，可以說已經影響到臺南市整體市容了，你想想，一條綠蔭步道做下 去那麼美，周遭的環境卻放任它這樣，如何好好地規劃留舊翻新，才能帶動整個臺南市的市 容，否則一項都市發展只做半套而已，鐵路地下化大概有四分之三在東區，接著才是北區和 永康區，東區的交通黑暗期造成很多市民不便，那是不是這段時間，針對忠孝里、大福里、 大德里、大同里那邊有很多的舊部落，我相信那邊也是一些經濟較弱勢和問題比較多的居民， 過去大家要是經濟過得去，誰要住在鐵路旁，是不是?住在鐵路旁的一定是一些經濟比較弱 勢、舊部落或者環境比較差的市民，所以我要請問都發局局長，針對這些區域，我們有沒有 規劃，讓這些地方有機會都更，那些舊部落有的範圍很大，不只是我照片拍的這樣。",[576],643,{"relatedOrgs":578,"summary":580,"editorNote":285,"say":581,"date":552,"type":543,"round":544,"src":582,"councilorRound":95},[579],"交通局","向交通局長提出鐵路地下化後，停車場設置，還有通勤站及轉乘設施。","所以我要提醒你要更費心，未來如果東區的榮民之家遷移後，關於停車位未來市府要怎 麼規劃，如果沒有從停車方便性下去考量規劃，會造成不方便。",[583],645,{"relatedOrgs":585,"summary":587,"editorNote":285,"say":588,"date":552,"type":543,"round":544,"src":589,"councilorRound":95},[586],"文化局","詢問文化局在東區林森路上的辦公廳舍的修復計畫進度","再來是市定古蹟，葉局長，這是什麼地方你知道嗎?這是在東區林森路上的辦公廳舍。",[583],{"relatedOrgs":591,"summary":593,"editorNote":285,"say":594,"date":552,"type":543,"round":544,"src":595,"councilorRound":95},[592],"水利局","詢問水利局因極端氣候，上半年缺水，下半年淹水，水的問題該如何解決","再來是上半年缺水，結果下半年雨水一來就開始淹水，表示現在都處於極端氣候，臺灣， 尤其是每年 7 月、8 月還有颱風季，像是今年 7 月底到 8 月還有西南氣流造成強降雨，雨勢很大，東區的地勢很高，幾乎可以說沒在淹水，但是裕農路尾要過隧道、三爺溪那裡，可以 說是逢水必淹，不用西南氣流或颱風來，只要短時強降雨就差不多會淹水了，你想想，這幾 10 年來的治水預算，臺南市應該拿了 700 億元到 800 億元。",[596],647,{"relatedOrgs":598,"summary":600,"editorNote":285,"say":601,"date":602,"type":543,"round":603,"src":604,"councilorRound":95},[579,599],"警察局","反映部分民眾濫用檢舉管道徒增基層人員業務，應與中央共同研擬修法。","市長，我延續剛才趙昆原議員所說的檢舉達人議題，這些檢舉達人都沒有經過交通相關訓練及教育，像我們交通警察也要經過考試才能執法，不是嗎？","2021-05-12",5,[605],91,{"relatedOrgs":607,"summary":609,"editorNote":285,"say":610,"date":602,"type":543,"round":603,"src":611,"councilorRound":95},[560,608],"經發局","要求放寬租金補助以及照顧住宅之資格，並增加相關社會福利預算。","市長，剛才盧議員說的幸福城市，其實有沒有幸福在這裡問不準，百姓心中最清楚，最簡單的拿臺南市的社會福利來說，剛才經發局長所說有些數據我們都贏在別人之前，",[612],103,{"relatedOrgs":614,"summary":615,"editorNote":285,"say":616,"date":602,"type":543,"round":603,"src":617,"councilorRound":95},[549,557],"建議若新營體育場修繕預算不足，市府可以考慮以BOT方式與民間合作，以期在全運會舉辦前完善必要場地。","市長，其實很可惜，你說要檢討該怎麼改善這些場地，我們一定要藉此次全國運動會這樣的大型比賽向中央爭取經費，是不是？",[618],108,{"relatedOrgs":620,"summary":621,"editorNote":285,"say":622,"date":623,"type":543,"round":624,"src":625,"councilorRound":95},[],"指出市府開放萊豬進口一意孤行，為拼外交，犧牲國人健康。","市長，你沒有覺得政府不\n顧人民的抗議一意孤行嗎？政府開放萊豬的進口，","2020-11-13",4,[626],674,{"relatedOrgs":628,"summary":629,"editorNote":285,"say":630,"date":623,"type":543,"round":624,"src":631,"councilorRound":95},[],"要求堅持學校禁用萊豬。","現在學校是不是全面禁用萊豬？",[632],675,{"relatedOrgs":634,"summary":635,"editorNote":285,"say":636,"date":623,"type":543,"round":624,"src":637,"councilorRound":95},[],"要求市府堅持美國豬肉零檢出，賣場分設美國豬肉、台灣豬肉專區。","現\n在別的縣市都在強力宣示零檢出，每個地方都有自訂罰則，",[632],{"relatedOrgs":639,"summary":640,"editorNote":285,"say":641,"date":623,"type":543,"round":624,"src":642,"councilorRound":95},[],"指長榮大學命案的嫌犯有偷拿女性私密衣物的前科，質疑地方警察局原本應該列管追蹤。要求建立防制列管追蹤機制，透過警力、就醫、心理輔導、藥物治療記錄，改善再犯率。","市長，說完食安說一下治安，發生這件事情，我們要痛定思痛",[643],679,{"relatedOrgs":645,"summary":646,"editorNote":285,"say":647,"date":623,"type":543,"round":624,"src":648,"councilorRound":95},[],"要求針對監視器系統的裝設維護、道路照明、學校周邊安全進行總體檢。","監視器系統的裝設和維護、道路照明和學校周邊的安全一定要總體檢",[643],{"relatedOrgs":650,"summary":651,"editorNote":285,"say":652,"date":623,"type":543,"round":624,"src":653,"councilorRound":95},[],"指出大馬路的車流量高、行車記錄器多、店家監視器也多，要求詢問地方里長哪些地點確實需要監視器，裝在有效果的地方，且一次將預算編列足夠。","以\n前中央有編列監視器，後來沒有編列了",[654],680,{"relatedOrgs":656,"summary":657,"editorNote":285,"say":658,"date":623,"type":543,"round":624,"src":659,"councilorRound":95},[],"指出酒駕再犯率沒有因為新制上路改善，要求加強宣導此政策。且取締要有機動性，採取不定期、不定點的臨檢，達成酒駕攔檢的意義。","再來\n我要說酒駕不開車、酒駕零容忍。",[654],{"relatedOrgs":661,"summary":663,"editorNote":285,"say":664,"date":623,"type":543,"round":624,"src":665,"councilorRound":95},[662],"民政局","指泉南里的人口數多，活動中心卻只有30幾坪。要求爭取在泉南段497 號和685 號建設新活動中心與地下停車場。","市長，東區的泉南里5,300 多人，在東區算比較大的里，東區最大的就是大智里",[666],683,{"relatedOrgs":668,"summary":669,"editorNote":285,"say":670,"date":623,"type":543,"round":624,"src":671,"councilorRound":95},[],"建議透過2023年全國運動會的機會，向中央爭取經費整修所有運動場館。","臺南市在民國96 年舉辦過全中運之後就沒有大型的比賽\n了，我要向市長建議",[672],685,{"relatedOrgs":674,"summary":675,"editorNote":285,"say":676,"date":623,"type":543,"round":624,"src":677,"councilorRound":95},[],"反映臺南市提供選手的待遇和獎金都是六都最差。要求加強體育相關補助、獎勵、專任教練，留住好人才，帶動運動風氣。","你說選手的待遇和獎金，我說給你聽，像這次的全民運動會",[678],686,{"relatedOrgs":680,"summary":681,"editorNote":285,"say":682,"date":623,"type":543,"round":624,"src":683,"councilorRound":95},[],"要求市長重視校園雙機（冷氣機、空氣清淨設備），採用新風換氣系統，針對鄰近工業區的學校優先測試。","再來，市長我請問你，你知道現在有一種東西叫做新風換\n氣系統嗎？",[678],{"relatedOrgs":685,"summary":686,"editorNote":285,"say":687,"date":688,"type":543,"round":689,"src":690,"councilorRound":95},[],"反映後甲社區居民煩惱後甲里斷層帶之地震危害","問題一:裕農路161kv問題","2020-05-27",3,[691],135,{"relatedOrgs":693,"summary":695,"editorNote":285,"say":696,"date":688,"type":543,"round":689,"src":697,"councilorRound":95},[694,608],"研考會","反映後甲社區161kv電纜工程施作路線爭議目前尚未達成\n共識，要求市長協助處理施工單位持續施工問題","後甲社區有後甲舊變電所已經40年了(戶外型電磁波較強)",[691],{"relatedOrgs":699,"summary":700,"editorNote":285,"say":701,"date":688,"type":543,"round":689,"src":702,"councilorRound":95},[694,608],"要求市長協助徵收公墓地、變更地目使後甲社區居民提出\n變更的電纜施工路線可施行","後甲社區居民不是不讓施工，他們要求台電把地下電纜改走更改路徑從裕農路北側之後甲公園與已拆遷的第一示範公墓用地",[691],{"relatedOrgs":704,"summary":706,"editorNote":285,"say":707,"date":688,"type":543,"round":689,"src":708,"councilorRound":95},[705],"農業局","反映台南市寵物殯葬業無專法管理，業者遊走灰色地帶","台南市目前至少有4家民營的寵物殯葬葉，都未立案",[709],136,{"relatedOrgs":711,"summary":712,"editorNote":285,"say":707,"date":688,"type":543,"round":689,"src":713,"councilorRound":95},[705],"建議透過自治條例輔導寵物殯葬業可就地合法經營",[709],{"relatedOrgs":715,"summary":716,"editorNote":285,"say":717,"date":688,"type":543,"round":689,"src":718,"councilorRound":95},[],"反映流浪狗問題源頭來自非法養殖，私設繁殖場無相關法規\n可處理，詢問相關局處是否有解決方法","再來是流浪狗的問題，目前因無實施安樂死政策",[719],137,{"relatedOrgs":721,"summary":722,"editorNote":285,"say":723,"date":688,"type":543,"round":689,"src":724,"councilorRound":95},[],"建議雙軌並行: 推動寵物生產履歷及結合民間團體宣導領養\n代替購買","沒有買賣就沒有傷害。以認養代替購買",[719],{"relatedOrgs":726,"summary":727,"editorNote":285,"say":728,"date":688,"type":543,"round":689,"src":729,"councilorRound":95},[694,549],"要求國中小全面裝設冷氣案一定要執行，若有經費問題可先\n從國小低年級國中三年級、頂樓教室優先裝設","在上次議會總質詢針對台南市國中小全面裝設冷氣",[719],{"relatedOrgs":731,"summary":732,"editorNote":285,"say":728,"date":688,"type":543,"round":689,"src":733,"councilorRound":95},[694,549],"建議提前升級學校機電工程以提升可用電量，避免跳電",[719],{"relatedOrgs":735,"summary":736,"editorNote":285,"say":737,"date":688,"type":543,"round":689,"src":738,"councilorRound":95},[694,549],"要求應依一區一學校試辦民間投資冷氣、以太陽能供電","在北區開元國小進行試驗由民間投資冷氣機",[719],{"relatedOrgs":740,"summary":741,"editorNote":285,"say":742,"date":688,"type":543,"round":689,"src":743,"councilorRound":95},[694,549],"反映校園社區化導致校內外區隔不易，導致疫情封閉有效性及校園安全性問題","目前疫情因素趨緩，校園空間再度開放讓群眾使用",[719],{"relatedOrgs":745,"summary":746,"editorNote":285,"say":742,"date":688,"type":543,"round":689,"src":747,"councilorRound":95},[694,549],"因應校園社區化，建議擴大校園防護安全網路、透過教育宣\n導提高警覺性，並要求市長提出解決方法",[719],{"relatedOrgs":749,"summary":750,"editorNote":285,"say":751,"date":688,"type":543,"round":689,"src":752,"councilorRound":95},[694,549],"反映提早入學原因不一，入學測試難度過高，詢問是否改善","現在少子化的問題，導致現在的學校招生普遍不足",[753],138,{"relatedOrgs":755,"summary":756,"editorNote":285,"say":757,"date":688,"type":543,"round":689,"src":758,"councilorRound":95},[],"反映紓困申請程序複雜，民眾不知如何申辦","台灣連續好多天都沒有本土病例，台灣國家隊打了一場揚名國際的病毒戰爭",[753],{"relatedOrgs":760,"summary":761,"editorNote":285,"say":762,"date":688,"type":543,"round":689,"src":763,"councilorRound":95},[694,705],"反映無加保勞工、農漁民紓困排富發放一萬元程序過於複雜\n引發民怨","紓困方案有不用還的工會加保三萬元，勞保10萬要還的勞工貸款",[753],{"relatedOrgs":765,"summary":766,"editorNote":285,"say":767,"date":688,"type":543,"round":689,"src":768,"councilorRound":95},[694,560],"建議紓困以E化系統確認資格，由政府通知申請或發放","以東區來講申請一萬元的補助，申請1000多件，目前只有10餘件，比率只有1%多",[769],139,{"relatedOrgs":771,"summary":772,"editorNote":285,"say":773,"date":688,"type":543,"round":689,"src":774,"councilorRound":95},[],"詢問為何紓困比例全國第三名，但大部分民眾仍未領得紓困金","而台南市平均戶數的紓困比例上，台南市以0.92%的成績，拿到全國第3名",[769],{"relatedOrgs":776,"summary":777,"editorNote":285,"say":778,"date":688,"type":543,"round":689,"src":779,"councilorRound":95},[],"質疑發行酷碰券要綁訂行動支付未考量中老年人使用，應以現金發放最實際，或請市長提出更好的建議以符合人民的需求","台灣總體紓困規模加碼到1.05兆元，美國、英國、日本、南韓、新加坡等主要國家都祭出鉅額貸款紓困或現金直接補貼",[769],{"relatedOrgs":781,"summary":782,"editorNote":285,"say":783,"date":784,"type":543,"round":785,"src":786,"councilorRound":95},[],"針對生產路要往大同路的道路，拓寬後沒有機車道，建議市府能夠研議要如何改善，讓機車有自己的機車道","市長，照片上是生產路要往大同路的道路，我們現在這樣看是不是有機車道，現在拓寬以後變成沒有機車道，這樣機車如果要騎到大同路都要跟汽車爭道，那還不要緊，(下一張照片)你有看到計程車前面有一 格嗎？","2019-11-27",2,[787],900,{"relatedOrgs":789,"summary":790,"editorNote":285,"say":791,"date":784,"type":543,"round":785,"src":792,"councilorRound":95},[],"針對違規檢舉被無限上綱，建議市府能夠有個機制，避免公部門資源被濫用","接下來要跟市長討論一下，我發現現在民眾很會檢舉違規來彌補警力不足，我們的交通亂象有因為民眾的檢舉而有所改善嗎？",[793],901,{"relatedOrgs":795,"summary":796,"editorNote":285,"say":797,"date":798,"type":543,"round":785,"src":799,"councilorRound":95},[549],"詢問國立科學教育體驗未來館規劃進度","請教市長，聽說在臺南市東區生產路要興建一座國立科學教育體驗未來館，地方 上很歡迎，這是結合現代數位科技化的教學","2019-11-20",[800],653,{"relatedOrgs":802,"summary":803,"editorNote":285,"say":804,"date":798,"type":543,"round":785,"src":805,"councilorRound":95},[557],"反映網寮北基地規劃設計進度落後，質疑榮民之家能否如期搬遷","我再請教你，據我所知崇明路的榮民之家在 110 年要完成搬遷， 但我看網寮北那邊規劃設計的進度都落後",[806],654,{"relatedOrgs":808,"summary":810,"editorNote":285,"say":811,"date":798,"type":543,"round":785,"src":812,"councilorRound":95},[809],"衛生局","要求65 歲以上的老人免繳健保費，市府若要採取排富亦能接受","再來第二件事，上個會期我提出 65 歲以上的老人免繳健保費，這個案子你到底有沒 有要做?若要做，你就說你什麼時候要落實?若沒有，你就直接說你做不到",[813],655,{"relatedOrgs":815,"summary":817,"editorNote":285,"say":818,"date":798,"type":543,"round":785,"src":819,"councilorRound":95},[816],"環保局","肯定市長擋下龍崎牛埔掩埋場開發","不要說我只會罵你而已，在這裡 我也要肯定牛埔月世界掩埋場事件，那時說北、中、南的事業廢棄物要丟到牛埔，你上 任後就直接擋下來了",[820],656,{"relatedOrgs":822,"summary":823,"editorNote":285,"say":824,"date":798,"type":543,"round":785,"src":825,"councilorRound":95},[],"建議市長專心問政，下班或假日時間再去輔選","你看到新北市的侯友宜嗎?他上班時間不輔選也 不談政治全心市政，下班時間或假日他要去幫忙輔選或什麼，我們尊重",[826],657,{"relatedOrgs":828,"summary":829,"editorNote":285,"say":830,"date":798,"type":543,"round":785,"src":831,"councilorRound":95},[549],"要求市府在國民中小學安裝冷氣","新加坡的總理李光耀曾說過，新加坡能夠成功的秘訣就是冷氣機，它改變了熱帶區 域人民的生活，歷史上較先進的文明都是在較涼快的氣候下昌盛起來",[832],667,{"relatedOrgs":834,"summary":835,"editorNote":285,"say":836,"date":798,"type":543,"round":785,"src":837,"councilorRound":95},[549],"質疑台南在所有縣市最不重視體育、投注經費最少，反映民間需求直排輪標準場地，並要求市府設立體育局舉辦全國性賽事","市長，你認為體育重不重要?",[838],670,{"relatedOrgs":840,"summary":841,"editorNote":285,"say":842,"date":798,"type":543,"round":785,"src":843,"councilorRound":95},[816],"針對現有的城西或永康焚化廠這裡是否有可能增建或擴建","市長，我再針對垃圾問題向你建議一下，垃圾問題你也要重視，因為垃圾與人民息息相關，人一定會製造垃圾，我們市府原本規劃在城西做四期掩 埋場，但因那裡是國家級濕地，後來環評沒有過",[632],{"relatedOrgs":845,"summary":847,"editorNote":285,"say":848,"date":798,"type":543,"round":785,"src":849,"councilorRound":95},[846],"地政局","要求市府針對重劃區地上物的補償應遵照中央法令執行","我剛和局長說的都有紀錄，重劃區地上物的補償因為官員的錯誤讓廠商開工，我去 年就有質詢，提出法令第 40 條，他為了辯駁，他提第 18 條，",[850],676,{"relatedOrgs":852,"summary":853,"editorNote":285,"say":854,"date":855,"type":543,"round":856,"src":857,"councilorRound":95},[549],"反映東區公托幼兒園數量不足，要求增設公托幼兒園","感謝主席，市長我覺得公托幼兒園的需求嚴重不足，為什麼這麼說呢?以我們東區來 講","2019-05-15",1,[858],749,{"relatedOrgs":860,"summary":861,"editorNote":285,"say":862,"date":855,"type":543,"round":856,"src":863,"councilorRound":95},[599],"質疑拖吊公司為求績效侵犯警方執法人員，要求回歸公部門不要再委外拖吊。","是，再來我還是要跟你討論臺南市的委外拖吊。",[864],750,{"relatedOrgs":866,"summary":867,"editorNote":285,"say":868,"date":869,"type":543,"round":856,"src":870,"councilorRound":95},[],"抗議市長調降房屋稅政策跳票。","因為競選期間你有承諾，若當選要馬上凍漲和調降108年的房屋稅","2019-04-19",[871],94,{"relatedOrgs":873,"summary":874,"editorNote":285,"say":875,"date":869,"type":543,"round":856,"src":876,"councilorRound":95},[],"要求65歲以上老人免繳健保費。","為什麼我們臺南市是六都中唯一65歲以上的老人沒補助健保費",[877],97,{"relatedOrgs":879,"summary":880,"editorNote":285,"say":881,"date":869,"type":543,"round":856,"src":882,"councilorRound":95},[],"爭取在東區設立第二座國民運動中心","所以，今天我在此要向黃市長全力爭取第2 座的國民運動中心",[883],107,{"relatedOrgs":885,"summary":886,"editorNote":285,"say":887,"date":869,"type":543,"round":856,"src":888,"councilorRound":95},[558],"崇明路榮民之家搬遷後，土地可改做文化特區使用。","再來，崇明路的榮民之家，你知道嗎？",[618],{"relatedOrgs":890,"summary":891,"editorNote":285,"say":892,"date":869,"type":543,"round":856,"src":893,"councilorRound":95},[558],"打通並拓寬崇學路，與南大榮譽校區溝通，期望能使交通順暢。","而崇學路要拓寬，打通過來，是不是？",[894],109,{"relatedOrgs":896,"summary":897,"editorNote":285,"say":898,"date":869,"type":543,"round":856,"src":899,"councilorRound":95},[579],"委外拖吊場態度差，不應與他們續約。","請問市長，你知道拖吊合約3 年期滿了，這點你清楚嗎？",[900],123,{"relatedOrgs":902,"summary":903,"editorNote":285,"say":904,"date":905,"type":543,"round":856,"src":906,"councilorRound":95},[579],"質疑拖吊業者是