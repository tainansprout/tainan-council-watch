762,768,773,780,786,791,799,804,811,817,822,828,834,839,845,851,856,861,867,872,877,883,888,895,904,910,916,922,929,934,940,945,951,957,963,968,975,982,987,992,998,1006,1012,1017,1023,1030,1035,1041,1047,1052,1058,1064],{"relatedOrgs":537,"summary":539,"editorNote":285,"say":540,"date":541,"type":542,"round":543,"src":544,"councilorRound":95},[538],"教育局","建議教育局能夠推動國小的雙語教育，落實校校都有雙語政策","教育局局長，我們應該要加速推動國小的雙語教育，落實校校都有雙語政策，因為英文是現在很重要的學習基石，是國際的鑰匙。","2021-11-18","定期會",6,[545],784,{"relatedOrgs":547,"summary":548,"editorNote":285,"say":549,"date":541,"type":542,"round":543,"src":550,"councilorRound":95},[538],"建議在小新國小廁所角那邊在修進去一點，讓視野開闊，避免變成死角釀成意外","接下來是小新國小的大門口，那裡有條路當初是人家所捐，國小這邊現在全部都蓋到水溝，我現在先跟你講，你有個概念就好，那個廁所角就變成個死角，因為我也沒想到現在小新營會進步這麼多，所以變成有個死角在那邊，大家為了要上班就衝很快，所以很常在那邊發生車禍，以我現在這個年齡看到小朋友發生車禍很捨不得，將心比心，所以跟你建議小新國小廁所角那邊修進去一點沒關係，因為有一條水溝，修進去一點讓視野開闊，人家才看得到，這樣從北邊下來或從南邊要往北時，可以看到前後的車輛，才會去注意，這點我相信是小事而已，局長。",[551],785,{"relatedOrgs":553,"summary":555,"editorNote":285,"say":556,"date":541,"type":542,"round":543,"src":557,"councilorRound":95},[554],"工務局","針對舊部落私有巷道跟既有道路的認定爭議，建議工務局要有所作為，儘量把原則訂得更容易認定(不確定)","工務局局長，現在有個問題，民國 60 幾年、70 幾年時，我們舊部落私有巷道跟既有道路的認定爭議",[558],786,{"relatedOrgs":560,"summary":562,"editorNote":285,"say":563,"date":541,"type":542,"round":543,"src":564,"councilorRound":95},[561],"都發局","針對8米的商業區還沒允許容積許可與容積轉移，建議都發局能夠各區和中西區各別檢討","都發局局長，臺南市現在有一點問題，8 米的商業區現在還沒允許容積許可與容積轉移。",[565],787,{"relatedOrgs":567,"summary":569,"editorNote":285,"say":570,"date":571,"type":542,"round":543,"src":572,"councilorRound":95},[568],"消防局","質疑住宅警報器效果，希望消防局長重視","我建議你們要編列足額預算加裝警報器，因為那時候你們用的那種警報器我覺得效 果好像不太好，上次我們也有加裝屋內的那種......","2021-11-02",[573],448,{"relatedOrgs":575,"summary":576,"editorNote":285,"say":577,"date":571,"type":542,"round":543,"src":578,"councilorRound":95},[],"建議市長老舊房屋強制都更","我覺得三十年以上的老舊房屋可以研 究看看是否能夠強制都更，不然早期巷弄僅能容許腳踏車經過，若周邊住宅發生問題我 們很難處理，所以研議看看，若能強制都更這樣更好。",[579],449,{"relatedOrgs":581,"summary":582,"editorNote":285,"say":583,"date":571,"type":542,"round":543,"src":584,"councilorRound":95},[568],"希望消防局針對消防安全定期檢驗、高樓防災演練、強制購買消防設施","我覺得要協調相關專業團隊來落實檢查消防安全的定期檢 查，並加強違樓及高風防建築的防災演練，局長，你不用回答，先請坐。第四，強制規 定買賣需要相關消防設施，房屋租賃房東有負擔消防設備的必要，",[579],{"relatedOrgs":586,"summary":587,"editorNote":285,"say":588,"date":571,"type":542,"round":543,"src":589,"councilorRound":95},[554],"希望工務局長重視高鐵周邊交通問題，南科發展迅速，附近上班時間塞車嚴重","再來是催生高鐵周邊聯外道路系統的開闢，提升整體交通環境品質， 我的意思是因為南科發展快速，早上到南科六點多到八點多這段時間，八點多到公司都 遲到了，都是因為塞車",[579],{"relatedOrgs":591,"summary":593,"editorNote":285,"say":594,"date":571,"type":542,"round":543,"src":595,"councilorRound":95},[592],"社會局","向社會局長提出台南老年化問題，以及扶養比不斷升高，長照問題需慎重考量，因為少子化，所以因此退場的校園場館可以再利用為住宿型長照設施","再來說到我們推動住宿型長照服務的布建，因為臺灣現在已是高齡化社會，2021 年 臺灣撫養比攀升至 41.2%，也就是 15 歲至 65 歲的民眾，每 100 人要撫養老人與小孩的 人數有 41.3 人，依照國發會人口推估，在 2050 年撫養比會上升至 84.9%，我可能沒辦法 看到，但說實在的也我們要未雨綢繆多注意，因為現在人口已經十分老化，他們還推估 到 2070 年會達到 102%，100 個人就得撫養 102 個老人",[596],450,{"relatedOrgs":598,"summary":600,"editorNote":285,"say":601,"date":571,"type":542,"round":543,"src":602,"councilorRound":95},[599],"水利局","詢問水利局長蘇厝滯洪池是否可參照卑南溪親水公園設計改為水利文化教育園區，打造台南文化觀光城市","水利局，蘇厝滯洪池是否應該更名?照片是關山卑南溪親水公園設計規劃，人家規 劃的親水公園弄得那麼漂亮，這些都是關山卑南溪那座湖的規劃，那座湖不大，不像我 們曾文溪滯洪池 100 公頃那麼大，若我們依這樣的規劃模式改成水利文化教育園區，臺 南市這麼大，讓所有學童可以到此教育園區了解，我相信 100 公頃的滯洪池一天也玩不 完。蘇厝滯洪池目前進度是這樣，我去拍夕陽都很漂亮，上次有拿給市長看，市長還問 很漂亮是什麼地方，就是蘇厝滯洪池，我覺得水利局應該提出方案將蘇厝滯洪池改為水 利文化教育園區，",[603],451,{"relatedOrgs":605,"summary":606,"editorNote":285,"say":607,"date":571,"type":542,"round":543,"src":608,"councilorRound":95},[599],"質疑水利局長將太陽能板設置在良田上，設置在海埔地上沒問題，因為海埔地不利耕作，將太陽能板設置在良田上會使農作物供應不足，存糧缺乏，污染環境，有生態問題","好，請坐。市長，太陽能已入侵社區，你看照片中都是太陽能板，一旁都是良田，我 們國家的政策讓我想不通，民國 80 年時我擔任省農會理事 16 年，當時國家糧食政策怎 麼和現在政府的政策不太一樣，互相牴觸，這些糧食雖然都可以進口，但萬一有一天發 生天災，現在宇宙要怎麼運轉我們不知道，但一個國家照理說要有三年的戰備存糧，但 現在良田都拿來做太陽能板了，下方則種作物，現在最沒有知識的就這些鄉下人，在太 陽能板下栽種出來的作物他們也不太敢吃，也怕有什麼樣的污染，這些我不太了解，因 為我不是相關科系不太了解。種電種在海埔地我沒意見，那種地實在種不出什麼作物來， 但善化、安定這邊的土地真的全都是良田，可說是嘉南大平原最好的地，現在這是水利 署還是水利局提供出去的我不了解，你們現在提供安定抽水站到溪尾段的防汛道路，沿 線都要架設太陽能光電板，這污染社區環境，嚴重影響社區生活品質，剝奪居民日常享 受的休閒陽光，清新空氣都是自由的，社區居民很反對，為什麼抽水站到溪尾段要架設 太陽能光電板，是什麼原因?",[609],452,{"relatedOrgs":611,"summary":613,"editorNote":285,"say":614,"date":571,"type":542,"round":543,"src":615,"councilorRound":95},[612],"民政局","向民政局提出北玄宮之墓地轉為農業用地不得興建建築的問題，須再變更地目才能興辦事業計畫","民眾來陳情，安定區蘇厝、蘇林兩里活動中心的興辦事宜，公有地的變更已經有著 落了，北玄宮那塊地本來是墓地，我們不是已經變更地目了嗎?",[616],453,{"relatedOrgs":618,"summary":620,"editorNote":285,"say":621,"date":571,"type":542,"round":543,"src":622,"councilorRound":95},[619,561],"警察局","詢問警察局長蘇厝外來人口不斷增加，犯罪人口恐也將增加，但蘇厝唯一的派出所要遷移，民眾的安全何為？","性不會為了反對而反對，我不是這種人，蘇厝派出所自日據時代就存在了，這間派出所 是百年老店了，當初蘇厝只有 3,000 多人，現在已經快 6,000 人，外來人口一直增加，舊 部落中誰刁民，誰是良民大家都知道，所以民眾自己都可以防範，但現在外來人口增加， 我不是說外來人口一定會怎樣，但我覺得外來人口是未知數，萬一有酗酒、吸毒的人， 每天亂七八糟的怎麼辦，尤其舊部落的鄉下民眾遇到這種事要找的就是警察，一個位在 那裡已經上百年的派出所你們說要遷走，讓蘇厝、蘇林兩里的老百姓反彈很大。",[623],454,{"relatedOrgs":625,"summary":627,"editorNote":285,"say":628,"date":571,"type":542,"round":543,"src":629,"councilorRound":95},[626],"經發局","向經發局提出工業用地不足的問題，乙八工業區很適合當工業區，但政府無作為，乙八不斷被拿來炒地皮，道路也缺乏，應該重新審視，不足也可以做擴編考量","現在 善化、安定及新市的工業區已經都飽和了，沒什麼工業區用地，只剩舊有廠房，但現在 舊有廠房很多都做為丁建，一格約 100 坪，裡面有住家也有小型工廠，現在都是規劃成 這樣，我們那時都讓他們做這些工作，事實上現在工業區真的無法容納，我們要引鳳來 歸，一些外地的廠商，尤其我們希望南向政策和一些在大陸的廠商能再回來，很多人都 願意回來但卻沒有工業用地，我在此建議，經發局局長，我覺得工乙八那塊地很適合， 民國 70 幾年開發工乙八工業區，你光是劃定工業區在那裡讓人家炒地皮，我覺得也沒有 道理，為什麼可以炒地皮?就是因為沒有路，哪有工業區沒有路的，我還是第一次看過， 就只有我們善化小新營東面的那塊，市長，現在說的是紡織廠和廚具後面那裡，那塊地 叫工乙八工業區，至今還沒有路可以進去，只有一條 3、4 米的路而已，現在工廠都需要 板車和拖車，要怎麼進去，很多人來看完後就沒下文了，只有來買土地的，地皮炒一炒 而已，很可憐，那時候政府都沒有作為，不是你任期內的事，早期沒有作為，路也不開 闢，只劃設了工乙八工業區在那裡，到後來一坪 2、3 萬賣給別人，現在大家都一直炒， 都沒有工業區用地所以大家都想買",[630],455,{"relatedOrgs":632,"summary":634,"editorNote":285,"say":635,"date":636,"type":542,"round":637,"src":638,"councilorRound":95},[633],"勞工局","詢問勞工為何跟農漁民的紓困差額有落差","感謝主席。市長以及各局處局處長大家早安大家好，請問勞工局長，你應該都有跟勞動部在開會嘛？","2021-08-04",5,[639],847,{"relatedOrgs":641,"summary":643,"editorNote":285,"say":644,"date":636,"type":542,"round":637,"src":645,"councilorRound":95},[612,642],"地政局","建議對公墓與墓仔埔的使用做更詳下的規劃","市長，民國 101 年的時候我有講過「一村一公園」，我現在要給你的建議你聽著就好，民政局長也要注意一下",[639],{"relatedOrgs":647,"summary":649,"editorNote":285,"say":650,"date":651,"type":542,"round":637,"src":652,"councilorRound":95},[648],"衛生局","詢問疫苗分配及施打情形，建議中央核撥預算補助","感謝大家。我就略過打招呼，現在疫情那麼嚴重大家都躲在家裡，像我也都躲在家不敢出門，我現在要說的不是我們臺南市政府，中央政府從去年一直說有預備幾千萬劑的疫苗，當時民眾問我，","2021-07-15",[653],326,{"relatedOrgs":655,"summary":656,"editorNote":285,"say":657,"date":651,"type":542,"round":637,"src":658,"councilorRound":95},[599,554],"建議增設淨水廠或海水淡化廠，爭取停灌區域農作物補助款","來是開發替代水的問題，約一個月前梅雨季未到，你看曾文水庫都快見底了，曾文水庫可說是我們亞洲第二或第三大水庫了，都能見底了，所以政府應該要有新思維，要如何去開發替代水源因應旱象的需要。",[659],328,{"relatedOrgs":661,"summary":662,"editorNote":285,"say":663,"date":651,"type":542,"round":637,"src":664,"councilorRound":95},[612,554],"建議爭取安定蘇厝、蘇林增設里民活動中心","對，這樣的話這件事我回去就可以跟這些老人家說明，市長有同意但怨無，無怨少，人家說萬事起頭難，今天若有個開始，之後有辦法的話再加強，像我以前在善化做鎮長",[665],331,{"relatedOrgs":667,"summary":668,"editorNote":285,"say":669,"date":651,"type":542,"round":637,"src":670,"councilorRound":95},[612,554],"建議安定區增設殯儀館及靈骨塔","那個地方依我個人見解，可以作為一個園區是最好的，但要成立一個園區要有2 公頃的地，例如殯儀館之類的設施，現在那邊都是放牌位，因為那邊風水不錯所以位置都滿了，我那天也與區長研究是否在後方新設位置，這部分公所也有簽陳上來了，現在正在研議中。",[671],332,{"relatedOrgs":673,"summary":674,"editorNote":285,"say":675,"date":651,"type":542,"round":637,"src":676,"councilorRound":95},[554,561],"詢問防汛道路用地取得及南科特定區開發案辦理情形，爭取多編列公共設施","好，要快點。工務局局長，108 年我也曾向你提議過，當時你也答覆說我們會編列預算，針對安定仙祖廟延伸至蘇厝社區的防汛道路，我現在說那條路你知道嗎？",[677],333,{"relatedOrgs":679,"summary":680,"editorNote":285,"say":681,"date":651,"type":542,"round":637,"src":682,"councilorRound":95},[554,599],"建議在嘉南大圳旁開闢一條替代道路往北勢洲西拉雅大道接台1 線","因為時間也不多，我還有一事要建議工務局局長，從山上、大內出來到178 縣道要接省道這段路，我剛好住在這邊，每天早上上班時間塞車塞到要往嘉南大圳的路上，建議你是否能將西拉雅大道接往山上北勢洲，這是一條路",[683],336,{"relatedOrgs":685,"summary":686,"editorNote":285,"say":687,"date":688,"type":542,"round":637,"src":689,"councilorRound":95},[538],"詢問地方學校何時會開始整修工程","我請教你一下，蓮潭國中你們現在已經有在規劃了嗎？","2021-04-29",[690],1406,{"relatedOrgs":692,"summary":693,"editorNote":285,"say":694,"date":688,"type":542,"round":637,"src":695,"councilorRound":95},[538],"詢問善化棒球場何時會完工","好，再來那個棒球隊的部分，因為有三級棒球隊。",[690],{"relatedOrgs":697,"summary":698,"editorNote":285,"say":699,"date":700,"type":542,"round":701,"src":702,"councilorRound":95},[],"要求多少補貼老人健保費。","中華\n民國有六都，現在有五都的健保費都是市政府負擔，65 歲以上的老人健保。","2020-11-20",4,[703],853,{"relatedOrgs":705,"summary":706,"editorNote":285,"say":707,"date":700,"type":542,"round":701,"src":708,"councilorRound":95},[554],"反映蘇厝抽水站旁的防汛道路拓寬規劃，受到金爐佔用道路用地影響。要求儘速完成規劃。","再來，工務局，從賴清德市\n長的任內，在蘇厝抽水站旁邊有一條防汛道路",[709],854,{"relatedOrgs":711,"summary":712,"editorNote":285,"say":713,"date":714,"type":542,"round":701,"src":715,"councilorRound":95},[],"關於美豬進口，要求市府團隊做好食安把關。","今天全臺灣的所有民眾，包括\n各縣市都為了美豬即將進口「拒絕萊豬守護食安」，","2020-11-06",[716],485,{"relatedOrgs":718,"summary":719,"editorNote":285,"say":720,"date":714,"type":542,"round":701,"src":721,"councilorRound":95},[619],"表示聽醫學博士說萊克多巴胺比搖頭丸還毒，如果警察局有在抓搖頭丸，為什麼還讓萊克多巴胺進口台灣。要求積極向中央反映，堅持拒絕萊克多巴胺進口。","今天全臺灣的所有民眾，包括\n各縣市都為了美豬即將進口「拒絕萊豬守護食安」",[722],486,{"relatedOrgs":724,"summary":725,"editorNote":285,"say":726,"date":714,"type":542,"round":701,"src":727,"councilorRound":95},[],"據聞牛墟的地已經不再續租，建議可選定溪美里糖廠周邊台糖土地，要求打造善化牛墟市集文化園區。","市長，你是善化的女婿，你知道善化的牛墟嗎？因為我在當地很久",[728],487,{"relatedOrgs":730,"summary":731,"editorNote":285,"say":732,"date":714,"type":542,"round":701,"src":733,"councilorRound":95},[561],"詢問善化區啟動都市計畫重劃與整體開發的期程。","下一個議題，我們要加速都市計畫開發，促進地方\n合理開發利用，都市計畫通盤檢討的目的就是為了區域的整體發展",[734],488,{"relatedOrgs":736,"summary":737,"editorNote":285,"say":738,"date":714,"type":542,"round":701,"src":739,"councilorRound":95},[],"要求拓寬從目加溜灣到小新營的農路。","再來要向市長建議LM 已開發完成，周邊道路也要開發，我指的周邊道路\n指的是從目加溜灣前來善化的農路",[740],489,{"relatedOrgs":742,"summary":743,"editorNote":285,"say":744,"date":714,"type":542,"round":701,"src":745,"councilorRound":95},[561],"反映安定區住宅飽和，多次建議引入居住空間，詢問辦理進度。","再來，安定區屬於南科生活\n圈範圍，為因應南科產業近年來快速發展",[740],{"relatedOrgs":747,"summary":748,"editorNote":285,"say":749,"date":714,"type":542,"round":701,"src":750,"councilorRound":95},[626],"指若日後有類似竑榮水泥專區的案子果斷告知廠商不可能。","藉此機會我也順便要告訴經發局，日後如果再有『竑榮』這種案\n子要儘速解決，不要讓他們搞鬼搞怪",[740],{"relatedOrgs":752,"summary":753,"editorNote":285,"say":754,"date":714,"type":542,"round":701,"src":755,"councilorRound":95},[633],"反映印尼政府2021年起要求移工輸入國負擔移工來台費用，要求向勞動部反映，不要讓其他國家只會欺負台灣。","勞工局，日前參加地方活動常有民眾跟我抱怨，聽說印尼政府從明年1 月15 日起要\n求移工輸入國雇主負擔移工來臺費用",[756],490,{"relatedOrgs":758,"summary":759,"editorNote":285,"say":760,"date":714,"type":542,"round":701,"src":761,"councilorRound":95},[633],"反映農民聘用外勞打工，卻遭查緝罰錢，要求勞工局要接地氣，替市長做功德。","講坦白話，我們臺灣現在務農的都是八十歲以上老人，這些人不是缺錢生活",[756],{"relatedOrgs":763,"summary":764,"editorNote":285,"say":765,"date":714,"type":542,"round":701,"src":766,"councilorRound":95},[],"要求對豐德電廠的瓦斯管路與三和氣體原址擴建的事情嚴格把關。","再來，亞東氣\n體一事，市長知道吧？你們要做好把關",[767],491,{"relatedOrgs":769,"summary":770,"editorNote":285,"say":771,"date":714,"type":542,"round":701,"src":772,"councilorRound":95},[648],"指民眾種黑豆到新化年貨大街擺攤，因為沒有封口遭稽查罰款三萬。且衛生局內未妥善做好稽查記錄。要求要盡量幫百姓的忙，將心比心。","接著\n是衛生局的業務，你們的稽查科都會拿著雞毛當令箭",[767],{"relatedOrgs":774,"summary":775,"editorNote":285,"say":776,"date":777,"type":542,"round":701,"src":778,"councilorRound":95},[648],"質疑購買液相層析串聯質譜儀卻還沒建立檢驗項目。","請教衛生局局長，107 年我們有買一套機台是液相層析串聯質譜儀，有沒有？這是哪一個科長辦理的？","2020-10-08",[779],1764,{"relatedOrgs":781,"summary":782,"editorNote":285,"say":783,"date":777,"type":542,"round":701,"src":784,"councilorRound":95},[648],"詢問微生物鑑定儀器的使用項目。","109 年你是不是還有去採買\n一套微生物鑑定儀器？",[785],1768,{"relatedOrgs":787,"summary":788,"editorNote":285,"say":789,"date":777,"type":542,"round":701,"src":790,"councilorRound":95},[648],"質疑檢驗中心主任的領導有問題，讓主管自願降級去其他單位。要求局長查明。","好，我再請教，因為依我看你這個中心的問題比較多，你知道嗎？因為這兩年來你\n這邊人員的離職、調職有多少人",[785],{"relatedOrgs":792,"summary":793,"editorNote":285,"say":794,"date":795,"type":542,"round":796,"src":797,"councilorRound":95},[626],"反映許中營開發案縮小面積以規避環評，網上謠傳已通過審查，要求勘查評估","非常感謝主席。黃市長、秘書長及各局處的首長，大家早安","2020-06-23",3,[798],863,{"relatedOrgs":800,"summary":801,"editorNote":285,"say":802,"date":795,"type":542,"round":796,"src":803,"councilorRound":95},[626],"質疑山上森霸電廠在水源保護區，且加開二廠原有瓦斯管線承載量是否飽和，要求詳細說明","你不要成為市長的絆腳石，因為將來市長還要再選舉",[798],{"relatedOrgs":805,"summary":806,"editorNote":285,"say":807,"date":808,"type":542,"round":796,"src":809,"councilorRound":95},[],"反映中央振興方式稱呼不定、規則複雜，要求市長應向中央表達立場","謝謝主席，市長、各局處首長大家早安、大家好。因為時間的關係","2020-06-15",[810],646,{"relatedOrgs":812,"summary":813,"editorNote":285,"say":814,"date":808,"type":542,"round":796,"src":815,"councilorRound":95},[],"支持推動高齡友善關懷，補助65歲以上老人健保費","再來，因為外面流傳大家對你的感覺良好，尤其是很多長輩",[816],647,{"relatedOrgs":818,"summary":820,"editorNote":285,"say":814,"date":808,"type":542,"round":796,"src":821,"councilorRound":95},[819],"財稅局","反映虎頭埤社區住戶有意願向市府購買土地，要求是否協助改善居住環境",[816],{"relatedOrgs":823,"summary":824,"editorNote":285,"say":825,"date":808,"type":542,"round":796,"src":826,"councilorRound":95},[599],"反映安定滯洪池開發成功，建議第二階段景觀工程可進行滯洪池底環道拓寬、增加路面空間並栽種大型樹木","不是。這是曾文溪安定滯洪池的親水共融公園，這個在地方風評非常的好",[827],648,{"relatedOrgs":829,"summary":830,"editorNote":285,"say":831,"date":808,"type":542,"round":796,"src":832,"councilorRound":95},[538],"要求公立幼兒園招生應採取不抽籤方式，以交通便利優先考量","教育局，給孩子一個快樂的學習未來，讓孩子開心，家長放心的教育環境",[833],649,{"relatedOrgs":835,"summary":836,"editorNote":285,"say":837,"date":808,"type":542,"round":796,"src":838,"councilorRound":95},[538],"要求重視小新國小學童受教育權利、不應廢校，建議擴大小新國小校區","上次議員選舉我落選的時候，小新國小聽說要廢校，里長跑來跟我說要規劃成類似公立安養院性質的地方",[833],{"relatedOrgs":840,"summary":841,"editorNote":285,"say":842,"date":808,"type":542,"round":796,"src":843,"councilorRound":95},[],"詢問是否南科特定區ABC特區與NO特區會同一時間整體開發","你曾經跟我說要徵收那塊地要好幾億，我住在那邊土地也賣掉很多塊",[844],650,{"relatedOrgs":846,"summary":847,"editorNote":285,"say":848,"date":808,"type":542,"round":796,"src":849,"councilorRound":95},[],"建議NO特區規劃國中預定地可保留4公頃","當然是樂觀其成，等一下我還會講 ABC 的部分。現在 LM 有一塊國中預定地",[850],651,{"relatedOrgs":852,"summary":853,"editorNote":285,"say":854,"date":808,"type":542,"round":796,"src":855,"councilorRound":95},[],"反映LM特區有停車問題，建議未來規劃時要設立停車場","還有一點就是現在 LM 這邊因為停車問題非常困擾，當初政府可能沒想到這塊 LM，會有這麼多人進住",[850],{"relatedOrgs":857,"summary":858,"editorNote":285,"say":859,"date":808,"type":542,"round":796,"src":860,"councilorRound":95},[561],"建議徵收小新國小北側公園預定地設立善化圖書館","再來，打造一個優質的閱讀環境，推動閱讀風氣。本席認為優質的閱讀環境",[850],{"relatedOrgs":862,"summary":863,"editorNote":285,"say":864,"date":808,"type":542,"round":796,"src":865,"councilorRound":95},[561],"反映善化區住宅不足，建議通盤規劃時納入考量","對，你一定要儘快，因為我們那邊普遍大家都認為住宅區不夠",[866],652,{"relatedOrgs":868,"summary":869,"editorNote":285,"say":870,"date":808,"type":542,"round":796,"src":871,"councilorRound":95},[561],"要求加速南科ABC特定區開發，避免地方邊緣化以符合民眾期待","我這樣建議，你如果覺得有道理就採納。接下來",[866],{"relatedOrgs":873,"summary":874,"editorNote":285,"say":875,"date":808,"type":542,"round":796,"src":876,"councilorRound":95},[],"要求加速安定工業區更新擴編，若有進度應報告","好，你請坐。加速安定工業區更新擴編，我上次會期就已經有講過",[866],{"relatedOrgs":878,"summary":879,"editorNote":285,"say":880,"date":808,"type":542,"round":796,"src":881,"councilorRound":95},[561],"反映小新工業區只有縱貫公路有人設廠，後半無規劃，要求規劃使工廠可以進駐","再來，就是小新有劃了一個工業區，這是不是也是都發局",[882],653,{"relatedOrgs":884,"summary":885,"editorNote":285,"say":886,"date":808,"type":542,"round":796,"src":887,"councilorRound":95},[626,554],"反映大台南瓦斯管線侵占私人土地，若未來與民眾有爭端，應協助處理","再來，我在這邊建請工務局跟經濟發展局，如果以後有牽涉到一些財團",[882],{"relatedOrgs":889,"summary":890,"editorNote":285,"say":891,"date":892,"type":542,"round":637,"src":893,"councilorRound":95},[561,642],"詢問一般跟特定農業區的區分標準是什麼","謝謝主席。都發局長，我請教你","2020-05-10",[894],2269,{"relatedOrgs":896,"summary":898,"editorNote":285,"say":899,"date":900,"type":542,"round":901,"src":902,"councilorRound":95},[897],"秘書處","針對森霸電廠要再擴充第二電廠，要求市府召集相關的局處首長前往詳細勘查清楚","秘書長，說實在的因為市長日理萬機，我有一件事情，山上森霸電廠當初也是在你擔任經發局長時，據我所知，現在森霸電廠要再擴充第二電廠，環境影響評估都已經在進行了，但是我們在去年第一次去抗議後就不了了之，不知什麼原因躲在他們電廠中進行，市政府這時候跟我說與你們沒關係，可是他的所在地就是屬於臺南市政府，絕對與市政府息息相關","2019-11-26",2,[903],849,{"relatedOrgs":905,"summary":906,"editorNote":285,"say":907,"date":900,"type":542,"round":901,"src":908,"councilorRound":95},[626],"針對大臺南瓦斯的管線侵占到私人土地，詢問市府要如何處理","再來，經發局與工務局，我那天有提到大臺南瓦斯，我們事後有一起到現場勘查過，包括當初的南科興業等等，那天我沒有提到很多，現在我再多說一點，當初那條路剛好是在鐵路下方，規劃 12 米路，後來原臺南縣政府為了要再多空一些土地出來，最後只剩下 8 米路，其餘空出的土地，有些分給老百姓，大臺南瓦斯的管線就變成是在人家的私人土地上，我現在請教兩位，法律的部分你們較了解，我比較不懂，私人機構可以使用老 百姓的土地，然後就不理他們嗎？可以嗎？你只要跟我回覆可不可以就好了！",[909],850,{"relatedOrgs":911,"summary":912,"editorNote":285,"say":913,"date":900,"type":542,"round":901,"src":914,"councilorRound":95},[554],"針對電線杆有中華電信的線路，詢問中華電信有沒有繳交使用費，並質疑收費不合理，建議市府要全盤檢討、","蘇局長，不好意思，再繼續，中華電信和台電還有第四台，這些都息息相關，臺南市所有的電線桿，中華電信有沒有繳費？",[915],851,{"relatedOrgs":917,"summary":918,"editorNote":285,"say":919,"date":900,"type":542,"round":901,"src":920,"councilorRound":95},[554],"針對電線線路侵占到私人土地，詢問市府要向哪個單位反映","還有我們的領空法，你知不知道？局長，你跟我說說看可以請哪一個單位處理，我們這 些議員遇到台電、中華電信、第四台通通都求助無門，什麼原因？比如這條路是彎的， 他在這個轉彎處設了一支電線桿，然後又在另一邊設了另一支電線桿，就將電線拉過人 家的私人土地上，現在要請他遷移，迄今過了 6 個月都還沒移，你幫我想想看，我要找哪一個單位，告訴我哪一個單位可以讓我反映，好不好？主席，再給我 1 分鐘。",[921],852,{"relatedOrgs":923,"summary":924,"editorNote":285,"say":925,"date":926,"type":542,"round":901,"src":927,"councilorRound":95},[],"感謝市府決定將南科三期設於看西農場","首先感謝市長，這次科學園區第三期計畫，本席那天看到報紙刊載，網路上也有提到， 三期已經決定設置在臺南科學園區看西農場","2019-11-12",[928],429,{"relatedOrgs":930,"summary":931,"editorNote":285,"say":932,"date":926,"type":542,"round":901,"src":933,"councilorRound":95},[633],"要求市府應輔導像外送員等弱勢勞工團體","剛剛美燕姐也提到，外送員的勞權問題，剛 剛也說很多了，勞工局身為勞工主管機關，一定要有擔",[928],{"relatedOrgs":935,"summary":936,"editorNote":285,"say":937,"date":926,"type":542,"round":901,"src":938,"councilorRound":95},[612],"反映安定區納骨塔位使用率高，要求增設納骨塔","再者，我想要 向市長建議，留給善終先人一個永久追思的安置場所",[939],430,{"relatedOrgs":941,"summary":942,"editorNote":285,"say":943,"date":926,"type":542,"round":901,"src":944,"councilorRound":95},[612],"要求市府將善化第二市場用地變更成活動中心，供善化區3里民眾使用","我們要提升區里的生活品質、凝聚在地民眾的感情交流，現在怎麼讓里內、社區內\n第 3 屆 第 2 次定期會 市政總質詢 430\n的老百姓凝聚在一起",[939],{"relatedOrgs":946,"summary":947,"editorNote":285,"say":948,"date":926,"type":542,"round":901,"src":949,"councilorRound":95},[612,538],"要求市府變更原先預定學校用地，改為安定區蘇厝里、蘇林里 2 里的建設活動中心用地","再 來是安定的蘇厝里、蘇林里，這 2 里也需要活動中心，光這 2 里的人口數也有好幾千人， 因為本席剛好說到善化，所以希望蘇厝這邊也要處理",[950],431,{"relatedOrgs":952,"summary":953,"editorNote":285,"say":954,"date":926,"type":542,"round":901,"src":955,"councilorRound":95},[626],"要求市府應解決台南回流後，工業區等土地擴大的需求","再來我們要提升老舊工業區的競爭力，加速安定工業區附近用地的擴編計畫，因為\n  當前中美貿易的影響，很多台商都非常惶恐",[956],432,{"relatedOrgs":958,"summary":959,"editorNote":285,"say":960,"date":926,"type":542,"round":901,"src":961,"councilorRound":95},[538],"反對小新國小廢校","再來攸關百年大計，是我們兒童的受教問題。請教局長， 11 月 3 日教育局有去小\n新國小",[962],433,{"relatedOrgs":964,"summary":965,"editorNote":285,"say":966,"date":926,"type":542,"round":901,"src":967,"councilorRound":95},[538],"詢問市府財政能否支持善化國中、蓮潭國中運作；建議市府評估LM 旁邊尚未開發 的NO 地，再行規劃國中學校用地","我現在說的是國中部分。本席請問你，善化國中比較靠近溪尾，現在又 要蓋蓮潭國中，可能嗎",[962],{"relatedOrgs":969,"summary":971,"editorNote":285,"say":972,"date":926,"type":542,"round":901,"src":973,"councilorRound":95},[626,970],"環保局","要求經發局、環保局管制工業廢水，避免影響糧食安全","接著是地下水的問題，一些污水都吃進我們的肚子內。環\n  保局，環境惡化的主要原因是什麼",[974],434,{"relatedOrgs":976,"summary":978,"editorNote":285,"say":979,"date":926,"type":542,"round":901,"src":980,"councilorRound":95},[977,819],"交通局","要求打通安定東路連接國道8號","市長，要加速南科 A、B、C 特定區的開發，安定東路的道路開闢就很重要，我每次 質詢都會提到這個",[981],435,{"relatedOrgs":983,"summary":984,"editorNote":285,"say":985,"date":926,"type":542,"round":901,"src":986,"councilorRound":95},[819],"要求市府售予土地給隨著國民政府來台的居民","財政局長，關於居住正義，你可能知道我要 說什麼。虎頭埤那邊的住戶都殷殷期待，財稅局什麼時候要把那塊地賣給他們",[981],{"relatedOrgs":988,"summary":989,"editorNote":285,"say":990,"date":926,"type":542,"round":901,"src":991,"councilorRound":95},[554],"要求市府解解決大台南市瓦斯管線侵占民地問題","接著是大臺南市的瓦斯侵占民地問題，你知道這個人有多可惡嗎",[981],{"relatedOrgs":993,"summary":994,"editorNote":285,"say":995,"date":926,"type":542,"round":901,"src":996,"councilorRound":95},[554],"詢問電信公司架設電線桿，市府是否收取費用","我請教你，電信公司架設電線桿，市府有向他們收錢嗎?",[997],436,{"relatedOrgs":999,"summary":1000,"editorNote":285,"say":1001,"date":1002,"type":542,"round":1003,"src":1004,"councilorRound":95},[970,626],"質疑善化福隆科技未依既定申請清理爐渣。","本席這個 10 分鐘\n 發言，來請環保局長，現在我講就好，你先不要講，你如果有需要你再用書面","2019-05-16",1,[1005],777,{"relatedOrgs":1007,"summary":1008,"editorNote":285,"say":1009,"date":1002,"type":542,"round":1003,"src":1010,"councilorRound":95},[970],"質疑安定灰渣掩埋場遭掩埋死豬汙染地下水。","來一點，當初八八水災、莫拉克颱風的時候，有一些死豬被埋在灰渣掩埋\r場，這件事情市長你應該多少知道，以前在安定那有一個灰渣掩埋場。",[1011],780,{"relatedOrgs":1013,"summary":1014,"editorNote":285,"say":1015,"date":1002,"type":542,"round":1003,"src":1016,"councilorRound":95},[970],"質疑市府對竑榮混凝土廠的稽查方式有問題。","再來就是說，上次我曾經跟你說過巡查跟稽查，你們現在所有、你那天講的一套辦法， 那天市長在場、在竑榮混凝土廠那，你很多機會一直在按燈要發言",[1011],{"relatedOrgs":1018,"summary":1019,"editorNote":285,"say":1020,"date":1002,"type":542,"round":1003,"src":1021,"councilorRound":95},[599,554],"要求改善善化胡厝寮道路交通及排水規劃。","再來水利局，水利局我跟你說，現在在南科中路要通到麻豆那裡，因為現在所有的車輛都開往胡 厝寮那裡去",[1022],781,{"relatedOrgs":1024,"summary":1025,"editorNote":285,"say":1026,"date":1027,"type":542,"round":1003,"src":1028,"councilorRound":95},[],"建議推動台南新市政中心。","在此，我想說的是，我第一次提案建議到現在都沒有落實","2019-04-26",[1029],298,{"relatedOrgs":1031,"summary":1032,"editorNote":285,"say":1033,"date":1027,"type":542,"round":1003,"src":1034,"councilorRound":95},[],"建議推動65歲以上老人免健保費","再來是向你建議，比照其它五都65 歲以上老人的健保費都由政府負擔",[1029],{"relatedOrgs":1036,"summary":1037,"editorNote":285,"say":1038,"date":1027,"type":542,"round":1003,"src":1039,"councilorRound":95},[],"啟動安定工業區更新擴編計畫。","再來就是啟動我們安定工業區更新擴編計畫",[1040],299,{"relatedOrgs":1042,"summary":1043,"editorNote":285,"say":1044,"date":1027,"type":542,"round":1003,"src":1045,"councilorRound":95},[],"建議發放鄰長交通補助費。","因為大家都在提鄰長來連署簽名，我也來跟市長說，別人來說給我聽",[1046],300,{"relatedOrgs":1048,"summary":1049,"editorNote":285,"say":1050,"date":1027,"type":542,"round":1003,"src":1051,"councilorRound":95},[],"公設保留地通盤檢討，若不使用就要解編，還地於民。","再來就是公設保留地，本席過去也講過，我們公設保留地就是當時民國六十幾年政府下去通盤檢討",[1046],{"relatedOrgs":1053,"summary":1054,"editorNote":285,"say":1055,"date":1027,"type":542,"round":1003,"src":1056,"councilorRound":95},[],"個案善化道路土地爭議問題。","都發局，是什麼原因我會問你這個案子？因為現在很多人在看電視",[1057],301,{"relatedOrgs":1059,"summary":1060,"editorNote":285,"say":1061,"date":1027,"type":542,"round":1003,"src":1062,"councilorRound":95},[],"要求開放自辦重劃，不必所有都要公辦。","再來就是以前是地盡其利，提升土地資源有效利用，開放自辦重劃",[1063],302,{"relatedOrgs":1065,"summary":1066,"editorNote":285,"say":1067,"date":1027,"type":542,"round":1003,"src":1068,"councilorRound":95},[],"要求打通目加溜灣台19甲到國道八號道路。","再來是加速安定東路到南科園區北側新增聯外道路，那個道路要開闢。",[1069],303,{"org":1071},[1072,1074,1076,1078,1079,1081,1082,1083,1084,1085,1086,1087,1088,1089,1090,1091],{"name":554,"count":1073},14,{"name":561,"count":1075},10,{"name":626,"count":1077},9,{"name":538,"count":1077},{"name":612,"count":1080},7,{"name":599,"count"